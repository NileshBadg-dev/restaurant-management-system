@{
    ViewData["Title"] = "Access Restricted";
    ViewData["TitleKey"] = "auth.accessRestricted";
}

<div class="d-flex align-items-center justify-content-center min-vh-75 py-5">
    <div class="glass-card p-5 text-center shadow-lg border" style="max-width: 480px; border-radius: 20px; border-color: var(--border-color) !important;">
        <div class="mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 80px; height: 80px; font-size: 2.5rem;">
                <i class="fa-solid fa-shield-halved"></i>
            </span>
        </div>
        <h3 class="fw-bold mb-2" style="color: var(--brand-900); font-family: var(--font-heading);" data-i18n="auth.accessRestricted">Access Restricted</h3>
        <p class="text-secondary small mb-4" data-i18n="auth.accessRestrictedDesc">
            Your current assigned role does not have authorization to view this section or perform this operation.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a href="/Dashboard" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                <i class="fa-solid fa-gauge-high me-1"></i> <span data-i18n="auth.returnToDashboard">Return to Dashboard</span>
            </a>
            <a href="/Account/Logout" class="btn btn-outline-danger rounded-pill px-4 fw-semibold">
                <i class="fa-solid fa-right-from-bracket me-1"></i> <span data-i18n="header.signOut">Sign Out</span>
            </a>
        </div>
    </div>
</div>
