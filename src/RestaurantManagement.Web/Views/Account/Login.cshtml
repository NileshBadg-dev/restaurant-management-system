@model RestaurantManagement.Web.Models.LoginViewModel
@inject RestaurantManagement.Web.Services.IWebConfigCacheService ConfigCache
@{
    Layout = null;
    var setting = await ConfigCache.GetSettingsAsync();
    var restaurantName = string.IsNullOrWhiteSpace(Model.RestaurantName)
        ? (string.IsNullOrWhiteSpace(setting.RestaurantName) ? "Hotel Kumbharwada" : setting.RestaurantName)
        : Model.RestaurantName;
    var restaurantNameMr = string.IsNullOrWhiteSpace(Model.RestaurantNameMr)
        ? (string.IsNullOrWhiteSpace(setting.RestaurantNameMr) ? restaurantName : setting.RestaurantNameMr)
        : Model.RestaurantNameMr;
    var logoUrl = !string.IsNullOrWhiteSpace(Model.LogoUrl) ? Model.LogoUrl : (setting.LogoUrl ?? string.Empty);
    var initialChar = restaurantName.Trim().Length > 0 ? restaurantName.Trim()[0].ToString().ToUpperInvariant() : "H";
    var preferredLang = Model.PreferredLanguage == "mr" ? "mr" : "en";

    var enDictJson = ConfigCache.GetI18nDictionaryJson("en");
    var mrDictJson = ConfigCache.GetI18nDictionaryJson("mr");
    var signedOutFlag = TempData["Success"] != null;
}
<!DOCTYPE html>
<html lang="@preferredLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-page-title-key="header.signIn">@restaurantName</title>
    <link id="appFavicon" rel="icon" href="@(!string.IsNullOrEmpty(logoUrl) ? logoUrl : "/assets/hotel-logo.jpg")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var savedLang = localStorage.getItem('rms_lang');
                if (savedLang === 'mr' || savedLang === 'en') {
                    document.documentElement.setAttribute('lang', savedLang);
                }
            } catch (e) { }
        })();
    </script>
    <style>
        body.login-page-cream {
            background-color: var(--surface-page);
            background-image: none;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .login-card-clean {
            position: relative;
            width: 100%;
            max-width: 420px;
            background: var(--surface-card);
            border: 1.5px solid var(--border-color);
            border-radius: 20px;
            box-shadow: var(--shadow-lg);
            padding: 24px 28px 30px 28px;
        }

        .login-card-lang-row {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 8px;
        }

        .login-logo-circle {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            border: 3px solid var(--brand-900);
            background: var(--brand-600);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px auto;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 2.25rem;
        }

        .login-logo-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .login-hotel-title {
            text-align: center;
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--brand-900);
            margin-bottom: 22px;
            line-height: 1.3;
        }

        .login-field-label {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

        .login-input-48 {
            height: 48px;
            font-size: 16px !important;
            border-radius: 10px;
        }

        .login-password-wrap {
            position: relative;
        }

        .login-password-wrap .form-control {
            padding-right: 48px;
        }

        .login-eye-btn {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .login-eye-btn:hover {
            color: var(--brand-900);
            background: rgba(74, 35, 20, 0.08);
        }

        .login-submit-btn {
            height: 48px;
            font-size: 16px;
            font-weight: 700;
            border-radius: 12px;
            background-color: var(--brand-600);
            border-color: var(--brand-600);
            color: #FFFFFF;
        }

        .login-submit-btn:hover:not(:disabled) {
            background-color: var(--brand-700);
            border-color: var(--brand-700);
            color: #FFFFFF;
        }

        .login-submit-btn:disabled {
            opacity: 0.78;
            background-color: var(--brand-600);
            border-color: var(--brand-600);
            color: #FFFFFF;
        }

        .login-forgot-link {
            color: var(--brand-600);
            font-weight: 600;
            font-size: 0.875rem;
            text-decoration: none;
        }

        .login-forgot-link:hover {
            color: var(--brand-700);
            text-decoration: underline;
        }
    </style>
</head>
<body class="login-page-cream">
    <div id="rmsToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1095;"></div>

    <main class="login-card-clean animated-fade-in">
        <!-- (a) Language toggle inside top-right of card -->
        <div class="login-card-lang-row">
            <div class="lang-switcher-pill" role="group" aria-label="Language">
                <button type="button" class="lang-switch-btn" data-lang="en" onclick="I18n.setLanguage('en')">English</button>
                <button type="button" class="lang-switch-btn" data-lang="mr" onclick="I18n.setLanguage('mr')">मराठी</button>
            </div>
        </div>

        <!-- (b) Circular hotel logo (~96px) -->
        <div class="login-logo-circle" data-brand-logo-wrap>
            <img data-brand-logo-img src="@logoUrl" alt="@restaurantName" class="@(string.IsNullOrEmpty(logoUrl) ? "d-none" : "")" />
            <span data-brand-logo-fallback class="@(string.IsNullOrEmpty(logoUrl) ? "" : "d-none")">@initialChar</span>
        </div>

        <!-- (c) Hotel name in Marathi or English -->
        <h1 class="login-hotel-title" data-brand-name data-name-en="@restaurantName" data-name-mr="@restaurantNameMr">@restaurantName</h1>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 px-3 rounded-3 mb-3 d-flex align-items-center gap-2 small fw-semibold" role="alert" id="loginErrorAlert" data-error-key="@Model.ErrorKey">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span id="loginErrorText">@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Account" id="loginForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <!-- (d) User ID -->
            <div class="mb-3">
                <label for="Username" class="form-label login-field-label" data-i18n="auth.userIdLabel">User ID</label>
                <input type="text"
                       class="form-control login-input-48"
                       id="Username"
                       name="Username"
                       value="@Model.Username"
                       autocomplete="username"
                       autofocus
                       required
                       data-i18n-placeholder="auth.userIdPlaceholder"
                       placeholder="Enter User ID" />
            </div>

            <!-- (e) Password with show/hide eye -->
            <div class="mb-3">
                <label for="Password" class="form-label login-field-label" data-i18n="auth.passwordLabel">Password</label>
                <div class="login-password-wrap">
                    <input type="password"
                           class="form-control login-input-48"
                           id="Password"
                           name="Password"
                           value="@Model.Password"
                           autocomplete="current-password"
                           required
                           data-i18n-placeholder="auth.passwordPlaceholder"
                           placeholder="Enter Password" />
                    <button type="button"
                            class="login-eye-btn"
                            id="togglePasswordBtn"
                            data-i18n-aria="auth.togglePassword"
                            aria-label="Show or hide password">
                        <i class="fa-regular fa-eye" id="togglePasswordIcon"></i>
                    </button>
                </div>
                <div id="capsLockHint" class="small text-warning fw-semibold mt-1 d-none">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <span data-i18n="auth.capsLockOn">Caps Lock is on</span>
                </div>
            </div>

            <!-- (f) Remember me & Forgot password? on one row -->
            <div class="d-flex align-items-center justify-content-between mb-4 gap-2 flex-wrap">
                <div class="form-check m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox" id="RememberMe" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : "") />
                    <label class="form-check-label small fw-semibold" for="RememberMe" data-i18n="auth.rememberMe">Remember me</label>
                </div>
                <a href="#" class="login-forgot-link" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal" data-i18n="auth.forgotPassword">
                    Forgot password?
                </a>
            </div>

            <!-- (g) Log in button with spinner & disabled state -->
            <button type="submit" class="btn login-submit-btn w-100 d-flex align-items-center justify-content-center gap-2" id="loginSubmitBtn">
                <span class="spinner-border spinner-border-sm d-none" id="loginSpinner" role="status" aria-hidden="true"></span>
                <span id="loginBtnLabel" data-i18n="auth.logIn">Log in</span>
            </button>
        </form>
    </main>

    <!-- Forgot Password Modal -->
    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom" style="background: var(--surface-subtle);">
                    <h5 class="modal-title fw-bold" style="color: var(--brand-900);">
                        <i class="fa-solid fa-key me-2" style="color: var(--brand-600);"></i>
                        <span data-i18n="auth.resetPassword">Reset Password</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="fpMessage" class="alert d-none py-2 small fw-semibold mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" data-i18n="auth.userIdLabel">User ID</label>
                        <input type="text" id="fpUsername" class="form-control" data-i18n-placeholder="auth.userIdPlaceholder" placeholder="Enter User ID" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" data-i18n="auth.managerPinPlaceholder">Manager PIN (1234)</label>
                        <input type="password" id="fpPin" class="form-control" data-i18n-placeholder="auth.managerPinPlaceholder" placeholder="Manager PIN (1234)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" data-i18n="auth.newPasswordPlaceholder">New Password (min 4 chars)</label>
                        <input type="password" id="fpNewPassword" class="form-control" data-i18n-placeholder="auth.newPasswordPlaceholder" placeholder="New Password (min 4 chars)" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small" data-i18n="auth.confirmPasswordPlaceholder">Confirm New Password</label>
                        <input type="password" id="fpConfirmPassword" class="form-control" data-i18n-placeholder="auth.confirmPasswordPlaceholder" placeholder="Confirm New Password" />
                    </div>
                </div>
                <div class="modal-footer border-top" style="background: var(--surface-page);">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal" data-i18n="auth.back">Back</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4" id="fpSubmitBtn">
                        <span data-i18n="auth.resetAndSave">Reset &amp; Save</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script>
        (function () {
            const enDict = @Html.Raw(enDictJson);
            const mrDict = @Html.Raw(mrDictJson);

            I18n.init(enDict, mrDict, '@preferredLang');

            const serverConfig = {
                restaurantName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(restaurantName)),
                restaurantNameMr: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(restaurantNameMr)),
                logoUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(logoUrl))
            };

            try {
                const cachedRaw = localStorage.getItem(RmsUI.CONFIG_STORAGE_KEY);
                if (cachedRaw) {
                    const cached = JSON.parse(cachedRaw);
                    if (cached && cached.restaurantName) {
                        RmsUI.applyRestaurantBranding(cached);
                    }
                } else {
                    RmsUI.applyRestaurantBranding(serverConfig);
                }
            } catch (e) {
                RmsUI.applyRestaurantBranding(serverConfig);
            }

            fetch('/api/restaurant-settings/public')
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (data && data.restaurantName) {
                        RmsUI.applyRestaurantBranding(data);
                    }
                })
                .catch(function () { });

            function updateLoginErrorTranslation() {
                const errBox = document.getElementById('loginErrorAlert');
                const errText = document.getElementById('loginErrorText');
                if (errBox && errText) {
                    const key = errBox.getAttribute('data-error-key');
                    if (key) {
                        errText.textContent = I18n.t(key, errText.textContent);
                    }
                }
            }

            updateLoginErrorTranslation();
            I18n.onLanguageChange(updateLoginErrorTranslation);

            @if (signedOutFlag)
            {
                <text>
                RmsUI.showToast(I18n.t('auth.signedOutSuccess', 'You have been signed out successfully.'), 'success');
                </text>
            }

            const pwdInput = document.getElementById('Password');
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const toggleIcon = document.getElementById('togglePasswordIcon');
            const capsHint = document.getElementById('capsLockHint');

            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener('click', function () {
                    const isHidden = pwdInput.type === 'password';
                    pwdInput.type = isHidden ? 'text' : 'password';
                    toggleIcon.className = isHidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
                });
            }

            if (pwdInput && capsHint) {
                const checkCaps = function (e) {
                    if (e.getModifierState && e.getModifierState('CapsLock')) {
                        capsHint.classList.remove('d-none');
                    } else {
                        capsHint.classList.add('d-none');
                    }
                };
                pwdInput.addEventListener('keyup', checkCaps);
                pwdInput.addEventListener('keydown', checkCaps);
            }

            const loginForm = document.getElementById('loginForm');
            const submitBtn = document.getElementById('loginSubmitBtn');
            const spinner = document.getElementById('loginSpinner');
            const btnLabel = document.getElementById('loginBtnLabel');

            if (loginForm && submitBtn) {
                loginForm.addEventListener('submit', function () {
                    submitBtn.disabled = true;
                    if (spinner) spinner.classList.remove('d-none');
                    if (btnLabel) btnLabel.textContent = I18n.t('auth.loggingIn', 'Logging in...');
                });
            }

            const fpBtn = document.getElementById('fpSubmitBtn');
            if (fpBtn) {
                fpBtn.addEventListener('click', async function () {
                    const msgEl = document.getElementById('fpMessage');
                    const username = document.getElementById('fpUsername').value.trim();
                    const pin = document.getElementById('fpPin').value.trim();
                    const np = document.getElementById('fpNewPassword').value;
                    const cp = document.getElementById('fpConfirmPassword').value;

                    msgEl.className = 'alert d-none py-2 small fw-semibold mb-3';
                    if (np !== cp) {
                        msgEl.textContent = I18n.t('auth.passwordsMismatch');
                        msgEl.classList.add('alert-danger');
                        msgEl.classList.remove('d-none');
                        return;
                    }

                    fpBtn.disabled = true;
                    fpBtn.textContent = I18n.t('auth.updating');
                    try {
                        const resp = await fetch('/Account/ForgotPassword', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ username, managerPin: pin, newPassword: np, confirmPassword: cp })
                        });
                        const res = await resp.json();
                        msgEl.textContent = res.message || I18n.t('auth.resetError');
                        msgEl.classList.add(res.success ? 'alert-success' : 'alert-danger');
                        msgEl.classList.remove('d-none');
                        if (res.success) {
                            document.getElementById('Username').value = username;
                        }
                    } catch (e) {
                        msgEl.textContent = I18n.t('auth.serverError');
                        msgEl.classList.add('alert-danger');
                        msgEl.classList.remove('d-none');
                    } finally {
                        fpBtn.disabled = false;
                        fpBtn.textContent = I18n.t('auth.resetAndSave');
                    }
                });
            }
        })();
    </script>
</body>
</html>
