@model IEnumerable<BillDto>
@{
    ViewData["Title"] = "Billing & Invoices";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-file-invoice-dollar text-success me-1"></i> Billing & Invoices
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Billing & Invoices
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Order #</th>
                    <th>Table</th>
                    <th>Date & Time</th>
                    <th>Amount</th>
                    <th>Payment Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@bill.InvoiceNumber</td>
                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">@bill.OrderNumber</span></td>
                        <td>@(bill.TableNumber != null ? $"Table {bill.TableNumber}" : "Dine-in")</td>
                        <td class="small text-secondary">@bill.BillDate.ToString("g")</td>
                        <td class="fw-bold text-dark fs-6">₹@bill.GrandTotal.ToString("N0")</td>
                        <td>
                            @if (bill.IsPaid)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="fa-solid fa-check me-1"></i> Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1"><i class="fa-solid fa-clock me-1"></i> Pending Payment</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/Billing/Invoice/@bill.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="fa-solid fa-eye me-1"></i> View Tax Invoice
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
