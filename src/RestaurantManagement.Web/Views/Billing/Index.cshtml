@model IEnumerable<BillDto>
@{
    ViewData["Title"] = "Billing & Invoices";
    ViewData["TitleKey"] = "billing.title";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold" style="color: var(--brand-600);">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> <span data-i18n="nav.dashboard">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-file-invoice-dollar me-1" style="color: var(--brand-600);"></i> <span data-i18n="billing.title">Billing &amp; Invoices</span>
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0" style="color: var(--brand-900);">
            <i class="fa-solid fa-file-invoice-dollar me-2" style="color: var(--brand-600);"></i><span data-i18n="billing.title">Billing &amp; Invoices</span>
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> <span data-i18n="header.backToDashboard">Back to Dashboard</span>
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th data-i18n="billing.invoiceNo">Invoice #</th>
                    <th data-i18n="orders.col.orderNo">Order #</th>
                    <th data-i18n="orders.col.table">Table</th>
                    <th data-i18n="orders.col.dateTime">Date &amp; Time</th>
                    <th data-i18n="orders.col.amount">Amount</th>
                    <th data-i18n="billing.paymentStatus">Payment Status</th>
                    <th class="text-end" data-i18n="common.actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-file-invoice-dollar fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0 text-muted" data-i18n="billing.noBills">No invoices or bills generated yet.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var bill in Model)
                    {
                        var cleanNum = (bill.TableNumber ?? "").Replace("Table", "").Trim();
                        <tr>
                            <td class="fw-bold text-dark" data-locale-digits="@bill.InvoiceNumber">@bill.InvoiceNumber</td>
                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1" data-locale-digits="@bill.OrderNumber">@bill.OrderNumber</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(cleanNum))
                                {
                                    <span data-i18n-table data-table-num="@cleanNum">Table @cleanNum</span>
                                }
                                else
                                {
                                    <span data-i18n="orders.type.dineIn">Dine-in</span>
                                }
                            </td>
                            <td class="small text-secondary" data-locale-datetime="@bill.BillDate.ToString("O")">@bill.BillDate.ToString("g")</td>
                            <td class="fw-bold text-dark fs-6" data-locale-currency="@bill.GrandTotal">₹@bill.GrandTotal.ToString("N0")</td>
                            <td>
                                @if (bill.IsPaid)
                                {
                                    <span class="badge status-pill-available rounded-pill px-3 py-1"><i class="fa-solid fa-check me-1"></i> <span data-i18n="billing.paid">Paid</span></span>
                                }
                                else
                                {
                                    <span class="badge status-pill-occupied rounded-pill px-3 py-1"><i class="fa-solid fa-clock me-1"></i> <span data-i18n="billing.pendingPayment">Pending Payment</span></span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Billing/Invoice/@bill.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="fa-solid fa-eye me-1"></i> <span data-i18n="billing.viewTaxInvoice">View Tax Invoice</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
