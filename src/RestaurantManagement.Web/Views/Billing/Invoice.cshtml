@model BillDto
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
}

@{
    string cleanTableNo = (Model.TableNumber ?? "").Replace("Table", "").Trim();
    if (string.IsNullOrEmpty(cleanTableNo)) cleanTableNo = "Dine-in";
    else cleanTableNo = "Table " + cleanTableNo;
}

<style>
    @@media print {
        body {
            background: #ffffff !important;
            color: #000000 !important;
        }
        .app-sidebar, .top-header, .app-footer, .no-print, nav, .btn, .alert {
            display: none !important;
        }
        .main-content {
            padding: 0 !important;
            margin: 0 !important;
        }
        .thermal-receipt-container {
            width: 80mm !important;
            max-width: 80mm !important;
            margin: 0 auto !important;
            padding: 4mm !important;
            border: none !important;
            box-shadow: none !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 12px !important;
        }
        .thermal-receipt-container h3 {
            font-size: 16px !important;
        }
        .thermal-receipt-container table {
            font-size: 11px !important;
        }
    }
</style>

<div class="row mb-4 align-items-center no-print">
    <div class="col-md-8">
        <a href="/Billing" class="btn btn-outline-secondary btn-sm rounded-pill mb-2"><i class="fa-solid fa-arrow-left me-1"></i> Back to Bills List</a>
        <h2 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-receipt text-warning me-2"></i>GST Tax Invoice</h2>
    </div>
    <div class="col-md-4 text-md-end">
        <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-3 me-2 shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Print Thermal Bill (80mm)
        </button>
        @if (!Model.IsPaid)
        {
            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="fa-solid fa-credit-card me-1"></i> Collect Payment
            </button>
        }
        else
        {
            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> SETTLED & PAID</span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3 no-print" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3 no-print" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Printable Tax Invoice Paper Box -->
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="bg-white text-dark p-4 p-md-5 rounded-4 shadow-lg border thermal-receipt-container">
            <!-- Restaurant Header -->
            <div class="text-center border-bottom pb-3 mb-3">
                <h3 class="fw-bold mb-1" style="font-family: var(--font-heading);">GIRANA GARDEN FINE DINE & BAR</h3>
                <div class="small text-muted">101 Grand Galleria, MG Road, Ahmedabad - 380001</div>
                <div class="small text-muted">GSTIN: 24AAACG1234F1Z9 &bull; FSSAI: 11521018000452</div>
                <div class="small text-muted">Phone: +91 98765 43210 &bull; Email: contact@giranagarden.com</div>
            </div>

            <!-- Bill Info Row -->
            <div class="d-flex justify-content-between small text-muted border-bottom pb-2 mb-3">
                <div>
                    <div><strong>Invoice No:</strong> @Model.InvoiceNumber</div>
                    <div><strong>Table:</strong> @cleanTableNo</div>
                    <div><strong>Waiter:</strong> Amit Kumar</div>
                </div>
                <div class="text-end">
                    <div><strong>Date:</strong> @Model.BillDate.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    <div><strong>Customer:</strong> @(Model.Order?.CustomerName ?? "Guest")</div>
                    <div><strong>Covers:</strong> 4 Pax</div>
                </div>
            </div>

            <!-- Items Table -->
            <table class="table table-sm align-middle mb-4">
                <thead>
                    <tr class="border-bottom border-dark text-dark fw-bold">
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Order?.Items != null)
                    {
                        foreach (var item in Model.Order.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.ItemName</div>
                                    @if (!string.IsNullOrEmpty(item.SelectedVariantName))
                                    {
                                        <div class="small text-muted ps-2">&bull; Variant: @item.SelectedVariantName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                    {
                                        <div class="small text-muted ps-2 fst-italic">&bull; Note: @item.SpecialInstructions</div>
                                    }
                                </td>
                                <td class="text-center fw-bold">@item.Quantity</td>
                                <td class="text-end text-muted">₹@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">₹@item.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Calculation Summary -->
            <div class="row justify-content-end border-top pt-3">
                <div class="col-md-7">
                    <div class="d-flex justify-content-between mb-1 small">
                        <span>Taxable Subtotal:</span>
                        <span class="fw-bold">₹@Model.SubTotal.ToString("N2")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 small text-danger">
                            <span>Discount Applied:</span>
                            <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.ServiceCharge > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 small text-muted">
                            <span>Service Charge:</span>
                            <span>₹@Model.ServiceCharge.ToString("N2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>CGST (2.5%):</span>
                        <span>₹@Model.CGST.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>SGST (2.5%):</span>
                        <span>₹@Model.SGST.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between fs-4 fw-bold border-top border-dark pt-2 mt-2">
                        <span>Grand Total:</span>
                        <span class="text-success">₹@Model.GrandTotal.ToString("N0")</span>
                    </div>
                    @if (Model.IsPaid && Model.Payments.Any())
                    {
                        <div class="border-top pt-2 mt-2 small text-muted">
                            @foreach (var p in Model.Payments)
                            {
                                <div class="d-flex justify-content-between">
                                    <span>Paid via @p.PaymentMethodName:</span>
                                    <span class="fw-bold text-dark">₹@p.Amount.ToString("N0")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- UPI QR Code Box -->
            <div class="text-center py-3 border-top mt-3" id="invoiceQrBox">
                <div class="small text-muted mb-1">Scan to Pay via UPI (GPay / PhonePe / Paytm)</div>
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=upi://pay?pa=giranagarden@upi%26pn=GiranaGarden%26am=@Model.GrandTotal" alt="UPI QR Code" style="width: 100px; height: 100px;" class="img-fluid rounded border shadow-sm" />
                <div class="small text-muted mt-1 fw-bold">UPI ID: giranagarden@upi</div>
            </div>

            <!-- Footer Notes -->
            <div class="text-center text-muted small border-top pt-3 mt-3">
                <div>Thank you for dining at Girana Garden! Visit again.</div>
                <div class="fw-bold text-dark mt-1">Have a Great Day! &bull; FSSAI Lic. 11521018000452</div>
            </div>
        </div>
    </div>
</div>

<!-- Collect Payment Modal with Live Change Calculator -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CollectPayment" method="post" class="modal-content rounded-4 border-0 shadow-lg text-dark">
            <input type="hidden" name="BillId" value="@Model.Id" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-credit-card text-success me-2"></i>Settle Bill - ₹@Model.GrandTotal.ToString("N0")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Payment Method</label>
                    <select name="PaymentMethod" class="form-select" id="paymentMethodSelect" onchange="onPaymentMethodChange()">
                        <option value="1">Cash</option>
                        <option value="2">UPI / QR Code</option>
                        <option value="3">Credit Card</option>
                        <option value="4">Debit Card</option>
                        <option value="5">Wallet</option>
                        <option value="6">Split Payment</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Payable Amount (₹)</label>
                    <input type="number" step="0.01" name="Amount" id="payableAmountInput" class="form-control fw-bold fs-5 text-dark bg-light" value="@Model.GrandTotal" readonly />
                </div>

                <!-- Cash Tendered & Change Return Box (BRD Section 10.3 / 10.5) -->
                <div id="cashCalculationBox" class="p-3 bg-light rounded-3 border mb-3">
                    <div class="mb-2">
                        <label class="form-label text-dark fw-bold small">Cash Tendered by Customer (₹)</label>
                        <input type="number" step="1" id="cashReceivedInput" class="form-control form-control-lg fw-bold text-success border-success" value="@Model.GrandTotal" oninput="calculateChangeReturn()" placeholder="e.g. 1200" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold text-dark">Change to Return:</span>
                        <span class="fs-3 fw-bold text-primary" id="changeReturnDisplay">₹0.00</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-dark fw-bold small">Transaction / Reference ID (Optional)</label>
                    <input type="text" name="TransactionId" class="form-control" placeholder="UPI txn id / Card auth code..." />
                </div>

                <!-- UPI Mock QR Code -->
                <div class="text-center p-3 bg-light rounded border border-secondary-subtle my-3" id="modalUpiQrBox" style="display: none;">
                    <div class="small text-muted mb-2">Scan QR Code with GPay / PhonePe / Paytm</div>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=upi://pay?pa=giranagarden@upi%26pn=GiranaGarden%26am=@Model.GrandTotal" alt="UPI QR Code" class="img-fluid rounded border shadow-sm" />
                    <div class="small text-primary mt-2 fw-bold">giranagarden@upi</div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" id="confirmSettleBtn" class="btn btn-success rounded-pill px-4 fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i> Confirm Settlement & Settle Table
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const grandTotal = @Model.GrandTotal;

    function onPaymentMethodChange() {
        const mode = document.getElementById('paymentMethodSelect').value;
        const cashBox = document.getElementById('cashCalculationBox');
        const upiBox = document.getElementById('modalUpiQrBox');

        if (mode === "1") { // Cash
            cashBox.style.display = "block";
            upiBox.style.display = "none";
            calculateChangeReturn();
        } else if (mode === "2") { // UPI
            cashBox.style.display = "none";
            upiBox.style.display = "block";
            document.getElementById('confirmSettleBtn').disabled = false;
        } else {
            cashBox.style.display = "none";
            upiBox.style.display = "none";
            document.getElementById('confirmSettleBtn').disabled = false;
        }
    }

    function calculateChangeReturn() {
        const received = parseFloat(document.getElementById('cashReceivedInput').value) || 0;
        const change = received - grandTotal;
        const changeDisplay = document.getElementById('changeReturnDisplay');
        const settleBtn = document.getElementById('confirmSettleBtn');

        if (change >= 0) {
            changeDisplay.textContent = '₹' + change.toFixed(2);
            changeDisplay.className = 'fs-3 fw-bold text-success';
            settleBtn.disabled = false;
        } else {
            changeDisplay.textContent = 'Short ₹' + Math.abs(change).toFixed(2);
            changeDisplay.className = 'fs-3 fw-bold text-danger';
            settleBtn.disabled = true;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        onPaymentMethodChange();
    });
</script>
}
