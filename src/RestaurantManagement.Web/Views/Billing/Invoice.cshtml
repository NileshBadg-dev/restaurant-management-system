@model BillDto
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <a href="/Billing" class="btn btn-outline-secondary btn-sm rounded-pill mb-2"><i class="fa-solid fa-arrow-left me-1"></i> Back to Bills List</a>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-warning me-2"></i>GST Tax Invoice</h2>
        <p class="text-secondary mb-0">Invoice #: <strong>@Model.InvoiceNumber</strong> &bull; Order #: <strong>@Model.OrderNumber</strong></p>
    </div>
    <div class="col-md-4 text-md-end">
        <button onclick="window.print()" class="btn btn-outline-light rounded-pill px-3 me-2">
            <i class="fa-solid fa-print me-1"></i> Print Bill
        </button>
        @if (!Model.IsPaid)
        {
            <button class="btn btn-success rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="fa-solid fa-credit-card me-1"></i> Collect Payment
            </button>
        }
        else
        {
            <span class="badge bg-success fs-5 px-3 py-2"><i class="fa-solid fa-circle-check me-1"></i> SETTLED & PAID</span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Printable Tax Invoice Paper Box -->
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="bg-white text-dark p-4 p-md-5 rounded-4 shadow-lg border">
            <!-- Restaurant Header -->
            <div class="text-center border-bottom pb-3 mb-3">
                <h3 class="fw-bold mb-1">GIRANA GARDEN FINE DINE</h3>
                <div class="small text-muted">101 Grand Galleria, MG Road, Ahmedabad - 380001</div>
                <div class="small text-muted">GSTIN: 24AAACG1234F1Z9 &bull; Phone: +91 98765 43210</div>
            </div>

            <!-- Bill Info Row -->
            <div class="d-flex justify-content-between small text-muted border-bottom pb-2 mb-3">
                <div>
                    <div><strong>Bill No:</strong> @Model.InvoiceNumber</div>
                    <div><strong>Table #:</strong> @(Model.TableNumber ?? "Dine-in")</div>
                </div>
                <div class="text-end">
                    <div><strong>Date:</strong> @Model.BillDate.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    <div><strong>Customer:</strong> @(Model.Order?.CustomerName ?? "Rahul Sharma")</div>
                </div>
            </div>

            <!-- Items Table -->
            <table class="table table-sm align-middle mb-4">
                <thead>
                    <tr class="border-bottom border-dark">
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Order?.Items != null)
                    {
                        foreach (var item in Model.Order.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.ItemName</div>
                                    @if (!string.IsNullOrEmpty(item.SelectedVariantName))
                                    {
                                        <div class="small text-muted">Variant: @item.SelectedVariantName</div>
                                    }
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold">₹@item.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Calculation Summary -->
            <div class="row justify-content-end border-top pt-3">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Subtotal:</span>
                        <span class="fw-bold">₹@Model.SubTotal.ToString("N2")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 text-danger">
                            <span>Discount:</span>
                            <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>CGST (2.5%):</span>
                        <span>₹@Model.CGST.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>SGST (2.5%):</span>
                        <span>₹@Model.SGST.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between fs-4 fw-bold border-top border-dark pt-2 mt-2">
                        <span>Grand Total:</span>
                        <span>₹@Model.GrandTotal.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <!-- Footer Notes -->
            <div class="text-center text-muted small border-top pt-3 mt-4">
                <div>Thank you for dining with us! Visit again.</div>
                <div class="fw-bold text-dark mt-1">Girana Garden POS &bull; Have a Great Day!</div>
            </div>
        </div>
    </div>
</div>

<!-- Collect Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CollectPayment" method="post" class="modal-content">
            <input type="hidden" name="BillId" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title text-white"><i class="fa-solid fa-credit-card me-2"></i>Collect Payment - ₹@Model.GrandTotal.ToString("N0")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-secondary">Payment Method</label>
                    <select name="PaymentMethod" class="form-select bg-dark text-white border-secondary" id="paymentMethodSelect">
                        <option value="1">Cash</option>
                        <option value="2">UPI / QR Code</option>
                        <option value="3">Credit Card</option>
                        <option value="4">Debit Card</option>
                        <option value="5">Wallet</option>
                        <option value="6">Split Payment</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary">Payment Amount (₹)</label>
                    <input type="number" step="0.01" name="Amount" class="form-control bg-dark text-white border-secondary fs-4 text-warning" value="@Model.GrandTotal" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary">Transaction / Reference ID (Optional)</label>
                    <input type="text" name="TransactionId" class="form-control bg-dark text-white border-secondary" placeholder="UPI txn id / Card ref no..." />
                </div>

                <!-- UPI Mock QR Code -->
                <div class="text-center p-3 bg-light rounded border border-secondary-subtle my-3" id="upiQrBox">
                    <div class="small text-secondary mb-2">Scan QR Code with GPay / PhonePe / Paytm</div>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=upi://pay?pa=giranagarden@upi%26pn=GiranaGarden%26am=@Model.GrandTotal" alt="UPI QR Code" class="img-fluid rounded border shadow-sm" />
                    <div class="small text-primary mt-2 fw-bold">giranagarden@upi</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success rounded-pill px-4">Confirm Settlement</button>
            </div>
        </form>
    </div>
</div>
