        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Live Clock for Header
        function updateHeaderClock() {
            const now = new Date();
            const elem = document.getElementById('headerClockDate');
            if (elem) {
                const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' });
                const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
                elem.textContent = `${dateStr} - ${timeStr}`;
            }
        }
        setInterval(updateHeaderClock, 1000);
        updateHeaderClock();

        // 2. Order Status Donut Chart
        const donutCtx = document.getElementById('orderStatusDonutChart');
        if (donutCtx) {
            new Chart(donutCtx, {
                type: 'doughnut',
                data: {
                    labels: ['New', 'Preparing', 'Ready', 'Served', 'Cancelled'],
                    datasets: [{
                        data: [18, 22, 16, 14, 8],
                        backgroundColor: ['#3b82f6', '#f59e0b', '#10b981', '#8b5cf6', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: ${context.raw} orders`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 3. Employee Attendance Double Bar Chart
        const barCtx = document.getElementById('employeeAttendanceBarChart');
        if (barCtx) {
            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: ['Managers', 'Chefs / Cooks', 'Waiters', 'Housekeeping', 'Cashiers'],
                    datasets: [
                        {
                            label: 'On duty (present)',
                            data: [1, 2, 2, 2, 1],
                            backgroundColor: '#10b981',
                            borderRadius: 3,
                            barThickness: 16,
                            maxBarThickness: 18,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        },
                        {
                            label: 'Total registered staff',
                            data: [1, 2, 2, 2, 1],
                            backgroundColor: '#cbd5e1',
                            borderRadius: 3,
                            barThickness: 16,
                            maxBarThickness: 18,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { weight: '600', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            max: 2,
                            ticks: { stepSize: 1, precision: 0 },
                            grid: { color: '#f1f5f9' }
                        }
                    }
                }
            });
        }

        // 4. Sales Overview Smooth Green Area Chart
        const areaCtx = document.getElementById('salesOverviewAreaChart');
        if (areaCtx) {
            new Chart(areaCtx, {
                type: 'line',
                data: {
                    labels: ['Oct 6', 'Oct 7', 'Oct 8', 'Oct 9', 'Oct 10', 'Oct 11', 'Oct 12'],
                    datasets: [{
                        label: 'Sales Revenue',
                        data: [13000, 8000, 13500, 14000, 21000, 17000, 21000],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.14)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#10b981',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ₹' + Number(context.raw).toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { weight: '500', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            max: 30000,
                            ticks: {
                                stepSize: 10000,
                                callback: function(val) {
                                    return val === 0 ? '₹0' : Number(val).toLocaleString();
                                }
                            },
                            grid: { color: '#f1f5f9' }
                        }
                    }
                }
            });
        }
    });
</script>
}
