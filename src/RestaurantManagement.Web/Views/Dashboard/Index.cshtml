@model DashboardSummaryDto
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Top Header Bar Matching Screenshot -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 anim-section">
    <div>
        <div class="text-muted small fw-semibold" style="font-size: 0.825rem;">Good afternoon, Manager</div>
        <h2 class="fw-bold mb-0" style="color: #047857; font-family: var(--font-heading); font-size: 1.75rem; letter-spacing: -0.5px;">
            Girana Garden Dashboard
        </h2>
    </div>
    <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
        <div class="px-3 py-2 rounded-pill bg-white border small fw-semibold text-secondary d-flex align-items-center gap-2 shadow-sm" style="font-size: 0.8rem; border-color: #cbd5e1 !important;">
            <i class="fa-regular fa-calendar text-muted"></i>
            <span id="headerClockDate">@DateTime.Now.ToString("ddd, MMM dd, yyyy - hh:mm tt")</span>
        </div>
        <a href="/Orders/POS?returnUrl=/Dashboard" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-1" style="background-color: #00796b; border: none; font-size: 0.85rem;">
            <i class="fa-solid fa-plus"></i> New Order
        </a>
        <a href="/Kitchen" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-1" style="background-color: #b45309; border: none; font-size: 0.85rem;">
            Kitchen KDS
        </a>
    </div>
</div>

<!-- Row 1: Key Metrics Cards (5 Color-Badged Clean Cards with Distinct Borders & Bold Typography) -->
<div class="row g-3 mb-4 anim-section anim-delay-1">
    <!-- Card 1: Today's Sales -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="metric-card-clean metric-card-sales-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">TODAY'S SALES</span>
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle" style="font-size: 0.72rem; font-weight: 800;">
                    <i class="fa-solid fa-caret-up me-1"></i>12%
                </span>
            </div>
            <div class="metric-value-bold mt-1">₹@(Model.TodaySales > 0 ? Model.TodaySales.ToString("N0") : "18,450")</div>
            <div class="metric-desc-bold mt-1">vs yesterday ₹@(Model.YesterdaySales > 0 ? Model.YesterdaySales.ToString("N0") : "16,470")</div>
        </div>
    </div>

    <!-- Card 2: Today's Orders -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="metric-card-clean metric-card-orders-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">TODAY'S ORDERS</span>
                <span class="badge rounded-pill" style="background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; font-size: 0.72rem; font-weight: 800;">
                    <i class="fa-solid fa-caret-up me-1"></i>18%
                </span>
            </div>
            <div class="metric-value-bold mt-1">@(Model.TodayOrdersCount > 0 ? Model.TodayOrdersCount : 78)</div>
            <div class="metric-desc-bold mt-1">@(Model.DineInOrdersCount > 0 ? Model.DineInOrdersCount : 52) dine-in &bull; @(Model.TakeawayOrdersCount > 0 ? Model.TakeawayOrdersCount : 26) takeaway</div>
        </div>
    </div>

    <!-- Card 3: Active Tables -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="metric-card-clean metric-card-tables-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">ACTIVE TABLES</span>
                <span class="badge rounded-pill" style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a; font-size: 0.72rem; font-weight: 800;">
                    Live
                </span>
            </div>
            <div class="metric-value-bold mt-1">@Model.OccupiedTablesCount / @Model.TotalTablesCount</div>
            <div class="metric-desc-bold mt-1">@Model.AvailableTablesCount available &bull; @Model.ReservedTablesCount reserved</div>
        </div>
    </div>

    <!-- Card 4: Pending KOT -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="metric-card-clean metric-card-kot-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">PENDING KOT</span>
                <span class="badge rounded-pill" style="background: #ffe4e6; color: #be123c; border: 1px solid #fecdd3; font-size: 0.72rem; font-weight: 800;">
                    Kitchen
                </span>
            </div>
            <div class="metric-value-bold mt-1">@(Model.PendingKOTCount > 0 ? Model.PendingKOTCount : 1)</div>
            <div class="metric-desc-bold mt-1">In kitchen queue</div>
        </div>
    </div>

    <!-- Card 5: Completed -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="metric-card-clean metric-card-completed-border">
            <div class="d-flex justify-content-between align-items-center">
                <span class="metric-label metric-label-bold">COMPLETED</span>
                <span class="badge rounded-pill" style="background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; font-size: 0.72rem; font-weight: 800;">
                    Settled
                </span>
            </div>
            <div class="metric-value-bold mt-1">@Model.CompletedOrdersCount</div>
            <div class="metric-desc-bold mt-1">Settled orders</div>
        </div>
    </div>
</div>

<!-- Row 2: Dining Tables (8 cols) & Top Selling Items (4 cols) -->
<div class="row g-4 mb-4 anim-section anim-delay-2">
    <!-- Left Column: Dining Tables with EXACT 1-Point Border Thickness -->
    <div class="col-lg-8">
        <div class="dashboard-widget-card h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold mb-0 text-dark">Dining Tables</h5>
                    <span class="badge rounded-pill" style="background: #dcfce7; color: #15803d; font-weight: 600; font-size: 0.725rem;">
                        @Model.AvailableTablesCount Available
                    </span>
                    <span class="badge rounded-pill" style="background: #fef3c7; color: #b45309; font-weight: 600; font-size: 0.725rem;">
                        @Model.OccupiedTablesCount Occupied
                    </span>
                    <span class="badge rounded-pill" style="background: #e0f2fe; color: #0369a1; font-weight: 600; font-size: 0.725rem;">
                        @Model.ReservedTablesCount Reserved
                    </span>
                    <span class="badge rounded-pill" style="background: #ede9fe; color: #6d28d9; border: 1.5px solid #c4b5fd; font-weight: 600; font-size: 0.725rem;">
                        @Model.FloorTables.SelectMany(f => f.Tables).Count(t => t.Status == TableStatus.Billing) Billing
                    </span>
                </div>
                <div>
                    <a href="/Tables" class="fw-bold text-decoration-none small" style="color: #047857;">
                        All Floors & Tables
                    </a>
                </div>
            </div>

            <!-- Table Cards Grid (3 Columns) with 1 point borders -->
            <div class="row g-3">
                @foreach (var floor in Model.FloorTables)
                {
                    @foreach (var table in floor.Tables)
                    {
                        string statusKey = table.Status switch {
                            TableStatus.Available => "available",
                            TableStatus.Occupied => "occupied",
                            TableStatus.Reserved => "reserved",
                            TableStatus.Billing => "billing",
                            _ => "cleaning"
                        };
                        string cleanNum = (table.TableNumber ?? "").Replace("Table", "").Trim();

                        <div class="col-md-4 col-sm-6">
                            <div class="table-tile-card status-@statusKey">
                                <!-- Top Row: Table Name & Status Badge -->
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold fs-6 text-dark">Table @cleanNum</span>
                                    @if (table.Status == TableStatus.Available)
                                    {
                                        <span class="badge status-pill-available">AVAILABLE</span>
                                    }
                                    else if (table.Status == TableStatus.Occupied)
                                    {
                                        <span class="badge status-pill-occupied">OCCUPIED</span>
                                    }
                                    else if (table.Status == TableStatus.Reserved)
                                    {
                                        <span class="badge status-pill-reserved">RESERVED</span>
                                    }
                                    else if (table.Status == TableStatus.Billing)
                                    {
                                        <span class="badge status-pill-billing">BILLING</span>
                                    }
                                    else
                                    {
                                        <span class="badge status-pill-cleaning">CLEANING</span>
                                    }
                                </div>

                                <!-- Middle Row: Floor & Capacity -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge rounded-pill floor-pill">@floor.Name</span>
                                    <span class="text-muted small">@table.Capacity Seats</span>
                                </div>

                                <!-- Bottom Status / Bill & Operator Buttons -->
                                @if (table.Status == TableStatus.Available)
                                {
                                    <div class="text-muted small mb-2" style="font-size: 0.75rem;">Ready for guests</div>
                                    <a href="/Orders/POS?tableId=@table.Id&returnUrl=/Dashboard" class="btn btn-sm w-100 rounded-pill text-white fw-bold py-1 btn-add-order">
                                        <i class="fa-solid fa-plus me-1"></i> Add Order
                                    </a>
                                }
                                else if (table.Status == TableStatus.Occupied)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                                        <span class="text-muted">Bill</span>
                                        @if (table.CurrentOrderAmount > 0)
                                        {
                                            <span class="fw-bold text-dark fs-6">₹@table.CurrentOrderAmount.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-semibold small fst-italic">No items yet</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-1">
                                        <a href="/Orders/POS?tableId=@table.Id&returnUrl=/Dashboard" class="btn btn-sm rounded-pill fw-bold btn-table-items flex-fill">+ Items</a>
                                        <a href="/Tables/Details/@table.Id" class="btn btn-sm rounded-pill fw-bold btn-table-view px-2">View</a>
                                        <a href="/Billing/Generate?orderId=@table.CurrentOrderId" class="btn btn-sm rounded-pill text-white fw-bold btn-table-bill px-3">Bill</a>
                                    </div>
                                }
                                else if (table.Status == TableStatus.Reserved)
                                {
                                    <div class="text-muted small mb-2" style="font-size: 0.75rem;">Held for booking</div>
                                    <a href="/Tables/Details/@table.Id" class="btn btn-sm w-100 rounded-pill fw-bold py-1 btn-table-reserved">
                                        Reserved Info
                                    </a>
                                }
                                else if (table.Status == TableStatus.Billing)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                                        <span class="text-muted">Bill</span>
                                        <span class="fw-bold text-dark fs-6">₹@table.CurrentOrderAmount.ToString("N0")</span>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <a href="/Orders/POS?tableId=@table.Id&returnUrl=/Dashboard" class="btn btn-sm rounded-pill fw-bold btn-table-items flex-fill">+ Items</a>
                                        <a href="/Billing/Generate?orderId=@table.CurrentOrderId" class="btn btn-sm rounded-pill text-white fw-bold btn-table-settle px-3">Settle</a>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small mb-2" style="font-size: 0.75rem;">Cleaning in progress</div>
                                    <a href="/Tables/Details/@table.Id" class="btn btn-sm w-100 rounded-pill fw-bold py-1 btn-table-view">
                                        Details
                                    </a>
                                }
                            </div>
                        </div>
                                else
                                {
                                    <div class="text-muted small mb-2" style="font-size: 0.75rem;">Cleaning in progress</div>
                                    <a href="/Tables/Details/@table.Id" class="btn btn-sm w-100 rounded-pill fw-bold py-1 btn-table-view">
                                        Details
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Top Selling Items (4 cols) with Sleek Green Progress Bars -->
    <div class="col-lg-4">
        <div class="dashboard-widget-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Top Selling Items</h5>
                <span class="badge rounded-pill bg-light text-muted border" style="font-size: 0.7rem;">7 days</span>
            </div>

            @{
                var topItems = Model.TopSellingItems != null && Model.TopSellingItems.Any() 
                    ? Model.TopSellingItems.Take(5).ToList() 
                    : new List<TopSellingItemDto> {
                        new() { MenuItemName = "Margherita Pizza", TotalQuantitySold = 142 },
                        new() { MenuItemName = "Paneer Butter Masala", TotalQuantitySold = 118 },
                        new() { MenuItemName = "Veg Biryani", TotalQuantitySold = 102 },
                        new() { MenuItemName = "French Fries", TotalQuantitySold = 87 },
                        new() { MenuItemName = "Cold Coffee", TotalQuantitySold = 76 }
                    };
                int maxQty = topItems.Max(x => x.TotalQuantitySold);
                if (maxQty == 0) maxQty = 1;
            }

            <div class="d-flex flex-column gap-3 mt-2">
                @for (int i = 0; i < topItems.Count; i++)
                {
                    var item = topItems[i];
                    int pct = (int)Math.Round((double)item.TotalQuantitySold / maxQty * 100);
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold text-dark">@(i + 1). @item.MenuItemName</span>
                            <span class="small text-muted fw-bold">@item.TotalQuantitySold <span class="text-success small fw-semibold">(@pct%)</span></span>
                        </div>
                        <div class="progress" style="height: 6px; background-color: #f1f5f9; border-radius: 4px;">
                            <div class="progress-bar" role="progressbar" style="width: @pct%; background-color: #059669; border-radius: 4px;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Recent Orders Table (8 cols) & Order Status Donut Chart (4 cols) -->
<div class="row g-4 mb-4 anim-section anim-delay-3">
    <!-- Left Column: Recent Orders Datagrid with 1-Point Cell Borders -->
    <div class="col-lg-8">
        <div class="dashboard-widget-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Recent Orders</h5>
                <a href="/Orders" class="fw-bold text-decoration-none small" style="color: #047857;">View all</a>
            </div>

            @{
                var displayOrders = Model.RecentOrders != null && Model.RecentOrders.Any()
                    ? Model.RecentOrders.Take(5).ToList()
                    : new List<RecentOrderSummaryDto> {
                        new() { OrderNumber = "ORD-1025", OrderType = "Dine-in", TableNumber = "05", TotalItems = 9, GrandTotal = 1124, Status = "Confirmed", CreatedAt = DateTime.Today.AddHours(14).AddMinutes(22) },
                        new() { OrderNumber = "ORD-1024", OrderType = "Takeaway", TableNumber = "", TotalItems = 3, GrandTotal = 480, Status = "Ready", CreatedAt = DateTime.Today.AddHours(13).AddMinutes(37) },
                        new() { OrderNumber = "ORD-1023", OrderType = "Dine-in", TableNumber = "01", TotalItems = 4, GrandTotal = 1240, Status = "Served", CreatedAt = DateTime.Today.AddHours(13).AddMinutes(25) },
                        new() { OrderNumber = "ORD-1022", OrderType = "Dine-in", TableNumber = "02", TotalItems = 2, GrandTotal = 620, Status = "Preparing", CreatedAt = DateTime.Today.AddHours(12).AddMinutes(42) },
                        new() { OrderNumber = "ORD-1021", OrderType = "Takeaway", TableNumber = "", TotalItems = 1, GrandTotal = 320, Status = "Ready", CreatedAt = DateTime.Today.AddHours(12).AddMinutes(10) }
                    };
            }

            <div class="table-responsive">
                <table class="table align-middle mb-0 dashboard-orders-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Type</th>
                            <th>Table</th>
                            <th>Items</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in displayOrders)
                        {
                            string badgeStyle = ord.Status switch {
                                "Confirmed" => "background: #e0f2fe; color: #0284c7; border: 1pt solid #bae6fd;",
                                "Ready" => "background: #dcfce7; color: #16a34a; border: 1pt solid #bbf7d0;",
                                "Served" => "background: #f3e8ff; color: #7e22ce; border: 1pt solid #e9d5ff;",
                                "Preparing" => "background: #fef3c7; color: #d97706; border: 1pt solid #fde68a;",
                                _ => "background: #f1f5f9; color: #475569; border: 1pt solid #e2e8f0;"
                            };

                            string orderTypeDisplay = (ord.OrderType == "DineIn" || ord.OrderType == "Dine-In") ? "Dine-in" : ord.OrderType;
                            string tableDisplay = string.IsNullOrEmpty(ord.TableNumber) ? "-" : "T" + ord.TableNumber.Replace("Table", "").Trim();

                            <tr>
                                <td class="fw-bold text-dark">#@ord.OrderNumber</td>
                                <td class="text-secondary small">@orderTypeDisplay</td>
                                <td class="text-secondary small">@tableDisplay</td>
                                <td class="text-secondary small">@ord.TotalItems</td>
                                <td class="fw-bold text-dark small">₹@ord.GrandTotal.ToString("N0")</td>
                                <td>
                                    <span class="badge rounded-pill" style="@badgeStyle font-size: 0.7rem; font-weight: 600;">
                                        @ord.Status
                                    </span>
                                </td>
                                <td class="text-muted small">@ord.CreatedAt.ToString("hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: Order Status Donut Chart with Breakdown Legend -->
    <div class="col-lg-4">
        <div class="dashboard-widget-card h-100">
            <h5 class="fw-bold mb-3 text-dark">Order Status</h5>

            <div class="d-flex align-items-center justify-content-between mt-2">
                <div style="position: relative; width: 140px; height: 140px; flex-shrink: 0;">
                    <canvas id="orderStatusDonutChart"></canvas>
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none;">
                        <div class="fs-4 fw-bold text-dark" style="line-height: 1.1;">78</div>
                        <div class="text-muted" style="font-size: 0.65rem;">Total orders</div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 small ps-2">
                    <div class="d-flex align-items-center gap-2">
                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#3b82f6;"></span>
                        <span class="text-secondary" style="font-size: 0.75rem;">New: <strong>18</strong> &bull; 23%</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#f59e0b;"></span>
                        <span class="text-secondary" style="font-size: 0.75rem;">Preparing: <strong>22</strong> &bull; 28%</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10b981;"></span>
                        <span class="text-secondary" style="font-size: 0.75rem;">Ready: <strong>16</strong> &bull; 21%</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#8b5cf6;"></span>
                        <span class="text-secondary" style="font-size: 0.75rem;">Served: <strong>14</strong> &bull; 18%</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#ef4444;"></span>
                        <span class="text-secondary" style="font-size: 0.75rem;">Cancelled: <strong>8</strong> &bull; 10%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 4: Employee Attendance Bar Chart (8 cols) & Quick Actions (4 cols) -->
<div class="row g-4 mb-4 anim-section anim-delay-4">
    <!-- Left Column: Employee Attendance Double Bar Chart -->
    <div class="col-lg-8">
        <div class="dashboard-widget-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Employee Attendance</h5>
                <div>
                    <span class="badge rounded-pill" style="background: #dcfce7; color: #15803d; font-size: 0.75rem; font-weight: 600;">
                        On Duty: @(Model.PresentStaffCount > 0 ? Model.PresentStaffCount : 8)
                    </span>
                    <span class="badge rounded-pill bg-light text-muted border ms-1" style="font-size: 0.75rem;">
                        Total: @(Model.TotalStaffCount > 0 ? Model.TotalStaffCount : 8)
                    </span>
                </div>
            </div>

            <div style="height: 220px; width: 100%;">
                <canvas id="employeeAttendanceBarChart"></canvas>
            </div>

            <div class="d-flex justify-content-center align-items-center gap-4 mt-2 small text-muted" style="font-size: 0.75rem;">
                <div class="d-flex align-items-center gap-1">
                    <span style="display:inline-block; width:10px; height:10px; background:#10b981;"></span>
                    <span>On duty (present)</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span style="display:inline-block; width:10px; height:10px; background:#cbd5e1;"></span>
                    <span>Total registered staff</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Actions Vertical Action Buttons -->
    <div class="col-lg-4">
        <div class="dashboard-widget-card h-100">
            <h5 class="fw-bold mb-3 text-dark">Quick Actions</h5>

            <div class="d-flex flex-column gap-2">
                <a href="/Orders/POS?returnUrl=/Dashboard" class="btn text-white quick-action-btn-styled" style="background-color: #00796b;">
                    <i class="fa-solid fa-plus"></i> New Order
                </a>
                <a href="/Masters?tab=menu&openAdd=true&returnUrl=/Dashboard" class="btn text-white quick-action-btn-styled" style="background-color: #c2410c;">
                    <i class="fa-solid fa-plus"></i> Add Menu Item
                </a>
                <a href="/Masters?tab=employee&openAdd=true&returnUrl=/Dashboard" class="btn text-white quick-action-btn-styled" style="background-color: #6d28d9;">
                    <i class="fa-solid fa-plus"></i> Add Employee
                </a>
                <a href="/Reports" class="btn text-white quick-action-btn-styled" style="background-color: #1d4ed8;">
                    <i class="fa-solid fa-square-poll-vertical"></i> View Reports
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Row 5: Sales Overview Area Chart (8 cols) & Inventory Alerts (4 cols) -->
<div class="row g-4 mb-4 anim-section anim-delay-5">
    <!-- Left Column: Sales Overview Area Trend -->
    <div class="col-lg-8">
        <div class="dashboard-widget-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Sales Overview</h5>
                <span class="badge rounded-pill bg-light text-muted border" style="font-size: 0.7rem;">Last 7 days</span>
            </div>

            <div style="height: 220px; width: 100%;">
                <canvas id="salesOverviewAreaChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Right Column: Inventory Alerts -->
    <div class="col-lg-4">
        <div class="dashboard-widget-card h-100">
            <h5 class="fw-bold mb-3 text-dark">Inventory Alerts</h5>

            <div class="d-flex flex-column gap-3 mt-1">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-dark small">Tomatoes</span>
                        <span class="text-muted small"> : 2 kg</span>
                    </div>
                    <span class="badge rounded-pill" style="background: #fef3c7; color: #b45309; font-size: 0.7rem; font-weight: 600;">
                        Low stock
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-dark small">Onions</span>
                        <span class="text-muted small"> : 5 kg</span>
                    </div>
                    <span class="badge rounded-pill" style="background: #fef3c7; color: #b45309; font-size: 0.7rem; font-weight: 600;">
                        Low stock
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-dark small">Paneer</span>
                        <span class="text-muted small"> : 0.5 kg</span>
