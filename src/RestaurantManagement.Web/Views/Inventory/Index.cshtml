@model IEnumerable<InventoryItemDto>
@{
    ViewData["Title"] = "Inventory & Stock";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-boxes-stacked text-info me-2"></i>Inventory & Stock Management</h2>
        <p class="text-secondary mb-0">Track raw ingredients, minimum stock thresholds, stock-in/out adjustments, and critical alerts.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr class="text-secondary">
                    <th>Ingredient Item</th>
                    <th>Category</th>
                    <th>Current Stock</th>
                    <th>Minimum Level</th>
                    <th>Unit Cost</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-white">@item.Name</td>
                        <td><span class="badge bg-secondary">@item.Category</span></td>
                        <td class="fw-bold fs-5 @(item.IsLowStock ? "text-danger" : "text-success")">
                            @item.CurrentStock @item.Unit
                        </td>
                        <td class="small text-secondary">@item.MinimumStock @item.Unit</td>
                        <td>₹@item.UnitCost.ToString("N0") / @item.Unit</td>
                        <td>
                            @if (item.CurrentStock <= (item.MinimumStock / 2m))
                            {
                                <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-circle-exclamation me-1"></i> CRITICAL LOW</span>
                            }
                            else if (item.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i> LOW STOCK</span>
                            }
                            else
                            {
                                <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-circle-check me-1"></i> Optimal</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-info rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#adjustModal-@item.Id">
                                <i class="fa-solid fa-sliders me-1"></i> Adjust Stock
                            </button>
                        </td>
                    </tr>

                    <!-- Stock Adjust Modal -->
                    <div class="modal fade" id="adjustModal-@item.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <form asp-action="AdjustStock" method="post" class="modal-content text-start">
                                <input type="hidden" name="InventoryItemId" value="@item.Id" />
                                <div class="modal-header">
                                    <h5 class="modal-title text-white"><i class="fa-solid fa-sliders me-2"></i>Adjust Stock: @item.Name</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label text-secondary">Action Type</label>
                                        <select name="TransactionType" class="form-select bg-dark text-white border-secondary">
                                            <option value="IN">Stock In (Purchase Receive)</option>
                                            <option value="OUT">Stock Out (Manual Deduction)</option>
                                            <option value="WASTAGE">Wastage / Spoiled</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-secondary">Quantity (@item.Unit)</label>
                                        <input type="number" step="0.01" name="Quantity" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 10" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-secondary">Notes / Reason</label>
                                        <input type="text" name="Notes" class="form-control bg-dark text-white border-secondary" placeholder="Fresh stock received from supplier..." />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Update Stock</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>
