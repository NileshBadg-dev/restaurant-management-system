@model IEnumerable<InventoryItemDto>
@{
    ViewData["Title"] = "Inventory & Stock";
    ViewData["TitleKey"] = "inventory.title";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold" style="color: var(--brand-600);">
                        <i class="fa-solid fa-chart-pie me-1"></i> <span data-i18n="nav.dashboard">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-boxes-stacked me-1" style="color: var(--brand-600);"></i> <span data-i18n="inventory.title">Inventory &amp; Stock</span>
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0" style="color: var(--brand-900);">
            <i class="fa-solid fa-boxes-stacked me-2" style="color: var(--brand-600);"></i><span data-i18n="inventory.title">Inventory &amp; Stock</span>
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> <span data-i18n="header.backToDashboard">Back to Dashboard</span>
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th data-i18n="inventory.ingredient">Ingredient Item</th>
                    <th data-i18n="menu.category">Category</th>
                    <th data-i18n="inventory.currentStock">Current Stock</th>
                    <th data-i18n="inventory.minLevel">Minimum Level</th>
                    <th data-i18n="inventory.unitCost">Unit Cost</th>
                    <th data-i18n="menu.status">Status</th>
                    <th class="text-end" data-i18n="common.actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.Name</td>
                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">@item.Category</span></td>
                        <td class="fw-bold fs-6" style="color: @(item.IsLowStock ? "#991B1B" : "var(--leaf)");">
                            <span data-locale-number="@item.CurrentStock">@item.CurrentStock</span> @item.Unit
                        </td>
                        <td class="small text-secondary"><span data-locale-number="@item.MinimumStock">@item.MinimumStock</span> @item.Unit</td>
                        <td class="text-dark"><span data-locale-currency="@item.UnitCost">₹@item.UnitCost.ToString("N0")</span> / @item.Unit</td>
                        <td>
                            @if (item.CurrentStock <= (item.MinimumStock / 2m))
                            {
                                <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-exclamation me-1"></i> <span data-i18n="inventory.criticalLow">Critical Low</span></span>
                            }
                            else if (item.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> <span data-i18n="inventory.lowStock">Low Stock</span></span>
                            }
                            else
                            {
                                <span class="badge status-pill-available px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> <span data-i18n="inventory.optimal">Optimal</span></span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#adjustModal-@item.Id">
                                <i class="fa-solid fa-sliders me-1"></i> <span data-i18n="masters.adjustStock">Adjust Stock</span>
                            </button>
                        </td>
                    </tr>

                    <!-- Stock Adjust Modal -->
                    <div class="modal fade" id="adjustModal-@item.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <form asp-action="AdjustStock" method="post" class="modal-content rounded-4 border-0 shadow-lg text-start">
                                <input type="hidden" name="InventoryItemId" value="@item.Id" />
                                <div class="modal-header border-bottom">
                                    <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-sliders me-2 text-primary"></i>Adjust Stock: @item.Name</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Action Type</label>
                                        <select name="TransactionType" class="form-select">
                                            <option value="IN">Stock In (Purchase Receive)</option>
                                            <option value="OUT">Stock Out (Manual Deduction)</option>
                                            <option value="WASTAGE">Wastage / Spoiled</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Quantity (@item.Unit)</label>
                                        <input type="number" step="0.01" name="Quantity" class="form-control" placeholder="e.g. 10" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Notes / Reason</label>
                                        <input type="text" name="Notes" class="form-control" placeholder="Fresh stock received from supplier..." />
                                    </div>
                                </div>
                                <div class="modal-footer border-top">
                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save Adjustment</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>
