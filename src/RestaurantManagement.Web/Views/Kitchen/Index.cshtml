@model IEnumerable<KOTDto>
@{
    ViewData["Title"] = "Kitchen Display System (KDS)";
    var newKots = Model.Where(k => k.Status == KOTStatus.New || k.Status == KOTStatus.Accepted).ToList();
    var prepKots = Model.Where(k => k.Status == KOTStatus.Preparing).ToList();
    var readyKots = Model.Where(k => k.Status == KOTStatus.Ready).ToList();
}

<style>
    .kds-column {
        background: #1e293b;
        border-radius: 1rem;
        padding: 1.25rem;
        min-height: 75vh;
        box-shadow: 0 4px 15px rgba(0,0,0,0.12);
    }
    .kds-ticket {
        background: #0f172a;
        border-radius: 0.75rem;
        padding: 1.1rem;
        margin-bottom: 1.1rem;
        border-left: 5px solid;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .kds-ticket:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.3);
    }
    .age-badge-green {
        background-color: #059669;
        color: #ffffff;
    }
    .age-badge-amber {
        background-color: #d97706;
        color: #ffffff;
    }
    .age-badge-red {
        background-color: #dc2626;
        color: #ffffff;
        animation: pulseRed 1.5s infinite;
    }
    @@keyframes pulseRed {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.65; }
    }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-kitchen-set text-warning me-1"></i> Kitchen KDS
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-kitchen-set text-warning me-2"></i>Kitchen Display System (KDS)
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
        <button onclick="window.location.reload();" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-rotate me-1"></i> Refresh Queue
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Column 1: NEW KOTs -->
    <div class="col-lg-4">
        <div class="kds-column">
            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3">
                <h5 class="fw-bold mb-0 text-info"><i class="fa-solid fa-bell me-2"></i>NEW KOTs</h5>
                <span class="badge bg-info text-dark fs-6 rounded-pill">@newKots.Count</span>
            </div>

            @if (!newKots.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-check-circle fs-2 mb-2 text-muted"></i>
                    <p class="small mb-0 text-muted">No new KOT orders in queue.</p>
                </div>
            }
            @foreach (var kot in newKots)
            {
                var cleanTable = kot.TableNumber?.Replace("Table", "").Trim();
                var elapsedMins = (int)Math.Max(0, (DateTime.UtcNow - kot.CreatedAt).TotalMinutes);
                string ageClass = elapsedMins < 10 ? "age-badge-green" : (elapsedMins <= 20 ? "age-badge-amber" : "age-badge-red");
                var itemsJson = System.Text.Json.JsonSerializer.Serialize(kot.Items.Select(i => new { i.Quantity, i.MenuItemName, i.SpecialInstructions }));

                <div class="kds-ticket" style="border-left-color: #0dcaf0;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-white fs-5">@kot.KOTNumber</span>
                        <div class="d-flex gap-1 align-items-center">
                            <span class="badge @ageClass fw-semibold px-2 py-1"><i class="fa-solid fa-clock me-1"></i>@elapsedMins m</span>
                            <span class="badge bg-info text-dark fw-bold">Table @cleanTable</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-white py-0 px-2" title="Print KOT Slip" onclick="printKotSlip('@kot.KOTNumber', '@cleanTable', '@kot.WaiterName', '@kot.CreatedAt.ToString("g")', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemsJson)), '@kot.Notes')">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </div>
                    </div>
                    <div class="small text-secondary mb-2">
                        <span>Waiter: @kot.WaiterName</span> &bull; <span>Time: @kot.CreatedAt.ToString("t")</span>
                    </div>

                    <div class="border-top border-bottom border-secondary py-2 my-2">
                        @foreach (var item in kot.Items)
                        {
                            <div class="d-flex justify-content-between text-white fw-semibold mb-1">
                                <span><span class="badge bg-warning text-dark me-2">@item.Quantity x</span>@item.MenuItemName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                            {
                                <div class="small text-info ps-3 mb-1"><i class="fa-solid fa-comment-dots me-1"></i>@item.SpecialInstructions</div>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(kot.Notes))
                    {
                        <div class="small text-warning mb-3">
                            <i class="fa-solid fa-note-sticky me-1"></i>Note: @kot.Notes
                        </div>
                    }

                    <form asp-action="UpdateKOTStatus" method="post">
                        <input type="hidden" name="kotId" value="@kot.Id" />
                        <input type="hidden" name="status" value="@KOTStatus.Preparing" />
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2">
                            <i class="fa-solid fa-fire-burner me-1"></i> Start Cooking
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Column 2: PREPARING -->
    <div class="col-lg-4">
        <div class="kds-column">
            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3">
                <h5 class="fw-bold mb-0 text-warning"><i class="fa-solid fa-fire-burner me-2"></i>PREPARING</h5>
                <span class="badge bg-warning text-dark fs-6 rounded-pill">@prepKots.Count</span>
            </div>

            @if (!prepKots.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-utensils fs-2 mb-2 text-muted"></i>
                    <p class="small mb-0 text-muted">No orders currently cooking.</p>
                </div>
            }
            @foreach (var kot in prepKots)
            {
                var cleanTable = kot.TableNumber?.Replace("Table", "").Trim();
                var elapsedMins = (int)Math.Max(0, (DateTime.UtcNow - kot.CreatedAt).TotalMinutes);
                string ageClass = elapsedMins < 10 ? "age-badge-green" : (elapsedMins <= 20 ? "age-badge-amber" : "age-badge-red");
                var itemsJson = System.Text.Json.JsonSerializer.Serialize(kot.Items.Select(i => new { i.Quantity, i.MenuItemName, i.SpecialInstructions }));

                <div class="kds-ticket" style="border-left-color: #ffc107;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-white fs-5">@kot.KOTNumber</span>
                        <div class="d-flex gap-1 align-items-center">
                            <span class="badge @ageClass fw-semibold px-2 py-1"><i class="fa-solid fa-clock me-1"></i>@elapsedMins m</span>
                            <span class="badge bg-warning text-dark fw-bold">Table @cleanTable</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-white py-0 px-2" title="Print KOT Slip" onclick="printKotSlip('@kot.KOTNumber', '@cleanTable', '@kot.WaiterName', '@kot.CreatedAt.ToString("g")', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemsJson)), '@kot.Notes')">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </div>
                    </div>
                    <div class="small text-secondary mb-2">
                        <span>Waiter: @kot.WaiterName</span> &bull; <span>Time: @kot.CreatedAt.ToString("t")</span>
                    </div>

                    <div class="border-top border-bottom border-secondary py-2 my-2">
                        @foreach (var item in kot.Items)
                        {
                            <div class="d-flex justify-content-between text-white fw-semibold mb-1">
                                <span><span class="badge bg-warning text-dark me-2">@item.Quantity x</span>@item.MenuItemName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                            {
                                <div class="small text-info ps-3 mb-1"><i class="fa-solid fa-comment-dots me-1"></i>@item.SpecialInstructions</div>
                            }
                        }
                    </div>

                    <form asp-action="UpdateKOTStatus" method="post">
                        <input type="hidden" name="kotId" value="@kot.Id" />
                        <input type="hidden" name="status" value="@KOTStatus.Ready" />
                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2">
                            <i class="fa-solid fa-circle-check me-1"></i> Mark Ready
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Column 3: READY TO SERVE -->
    <div class="col-lg-4">
        <div class="kds-column">
            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3">
                <h5 class="fw-bold mb-0 text-success"><i class="fa-solid fa-tray me-2"></i>READY TO SERVE</h5>
                <span class="badge bg-success text-white fs-6 rounded-pill">@readyKots.Count</span>
            </div>

            @if (!readyKots.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-clock fs-2 mb-2 text-muted"></i>
                    <p class="small mb-0 text-muted">No prepared food waiting for pickup.</p>
                </div>
            }
            @foreach (var kot in readyKots)
            {
                var cleanTable = kot.TableNumber?.Replace("Table", "").Trim();
                var elapsedMins = (int)Math.Max(0, (DateTime.UtcNow - kot.CreatedAt).TotalMinutes);
                string ageClass = elapsedMins < 10 ? "age-badge-green" : (elapsedMins <= 20 ? "age-badge-amber" : "age-badge-red");
                var itemsJson = System.Text.Json.JsonSerializer.Serialize(kot.Items.Select(i => new { i.Quantity, i.MenuItemName, i.SpecialInstructions }));

                <div class="kds-ticket" style="border-left-color: #198754;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-white fs-5">@kot.KOTNumber</span>
                        <div class="d-flex gap-1 align-items-center">
                            <span class="badge @ageClass fw-semibold px-2 py-1"><i class="fa-solid fa-clock me-1"></i>@elapsedMins m</span>
                            <span class="badge bg-success text-white fw-bold">Table @cleanTable</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-white py-0 px-2" title="Print KOT Slip" onclick="printKotSlip('@kot.KOTNumber', '@cleanTable', '@kot.WaiterName', '@kot.CreatedAt.ToString("g")', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemsJson)), '@kot.Notes')">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </div>
                    </div>
                    <div class="small text-secondary mb-2">
                        <span>Waiter: @kot.WaiterName</span>
                    </div>

                    <div class="border-top border-bottom border-secondary py-2 my-2">
                        @foreach (var item in kot.Items)
                        {
                            <div class="d-flex justify-content-between text-white fw-semibold mb-1">
                                <span><span class="badge bg-success fs-6 me-2">@item.Quantity x</span>@item.MenuItemName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                            {
                                <div class="small text-info ps-3 mb-1"><i class="fa-solid fa-comment-dots me-1"></i>@item.SpecialInstructions</div>
                            }
                        }
                    </div>

                    <form asp-action="UpdateKOTStatus" method="post">
                        <input type="hidden" name="kotId" value="@kot.Id" />
                        <input type="hidden" name="status" value="@KOTStatus.Served" />
                        <button type="submit" class="btn btn-outline-light w-100 rounded-pill fw-bold py-2">
                            <i class="fa-solid fa-check-double me-1"></i> Mark Served
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function printKotSlip(kotNumber, tableNum, waiter, time, itemsJsonRaw, notes) {
        try {
            const items = JSON.parse(itemsJsonRaw);
            const win = window.open('', '_blank', 'width=380,height=600');
            if (!win) {
                alert('Pop-up blocked. Please allow pop-ups for KOT printing.');
                return;
            }
            let itemsHtml = items.map(i => `
                <div style="display:flex; justify-content:space-between; font-weight:bold; font-size:15px; margin:5px 0;">
                    <span>${i.Quantity} x ${i.MenuItemName}</span>
                </div>
                ${i.SpecialInstructions ? `<div style="font-size:12px; color:#444; margin-left:12px;">* ${i.SpecialInstructions}</div>` : ''}
            `).join('');

            win.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>KOT - ${kotNumber}</title>
                    <style>
                        @@page { size: 80mm auto; margin: 0; }
                        body { font-family: monospace; width: 72mm; margin: 0 auto; padding: 12px 0; font-size: 13px; color: #000; }
                        .center { text-align: center; }
                        .bold { font-weight: bold; }
                        .divider { border-top: 1px dashed #000; margin: 8px 0; }
                        .kot-num { font-size: 22px; font-weight: 900; margin: 4px 0; }
                        .table-num { font-size: 18px; font-weight: bold; }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    <div class="center bold">GIRANA GARDEN RESTAURANT</div>
                    <div class="center kot-num">${kotNumber}</div>
                    <div class="center table-num">TABLE: ${tableNum}</div>
                    <div class="divider"></div>
                    <div><strong>Waiter:</strong> ${waiter || 'General'}</div>
                    <div><strong>Time:</strong> ${time}</div>
                    <div class="divider"></div>
                    ${itemsHtml}
                    ${notes ? `<div class="divider"></div><div><strong>Special Note:</strong> ${notes}</div>` : ''}
                    <div class="divider"></div>
                    <div class="center bold" style="font-size:11px;">KITCHEN ORDER TICKET (ESC/POS)</div>
                </body>
                </html>
            `);
            win.document.close();
        } catch (e) {
            console.error('KOT Print Error', e);
        }
    }
</script>

