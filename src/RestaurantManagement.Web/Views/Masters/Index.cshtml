@using RestaurantManagement.Domain.Entities
@model MastersViewModel
@{
    ViewData["Title"] = "Masters";
    ViewData["TitleKey"] = "nav.masters";
    var activeTab = (Model.ActiveTab ?? "floor").ToLower();
}

<!-- Breadcrumb & Top Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold" style="color: var(--brand-600);">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> <span data-i18n="nav.dashboard">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-layer-group me-1" style="color: var(--brand-600);"></i> <span data-i18n="masters.title">Masters</span>
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0" style="color: var(--brand-900);">
            <i class="fa-solid fa-layer-group me-2" style="color: var(--brand-600);"></i><span data-i18n="masters.title">Masters</span>
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Return to main dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> <span data-i18n="header.backToDashboard">Back to Dashboard</span>
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Modern Horizontal Masters Tabs Navigation -->
<div class="glass-card p-2 mb-4 animated-fade-in shadow-sm">
    <div class="masters-nav-tabs" id="mastersTab" role="tablist">
        <button class="masters-nav-tab-btn @(activeTab == "floor" ? "active" : "")" 
                id="floor-tab" data-bs-toggle="tab" data-bs-target="#floor-pane" type="button" role="tab" title="Floors & Zones">
            <i class="fa-solid fa-building text-warning fs-5"></i>
            <span data-i18n="masters.floors">Floors</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Floors.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "table" ? "active" : "")" 
                id="table-tab" data-bs-toggle="tab" data-bs-target="#table-pane" type="button" role="tab" title="Dining Tables">
            <i class="fa-solid fa-chair text-info fs-5"></i>
            <span data-i18n="masters.tables">Tables</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Tables.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "menu" ? "active" : "")" 
                id="menu-tab" data-bs-toggle="tab" data-bs-target="#menu-pane" type="button" role="tab" title="Food & Beverage Menu">
            <i class="fa-solid fa-bowl-food fs-5" style="color: var(--leaf);"></i>
            <span data-i18n="masters.menuItems">Menu Items</span>
            <span class="badge bg-light text-dark border ms-1" data-locale-number="@Model.MenuItems.Count()">@Model.MenuItems.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "category" ? "active" : "")" 
                id="category-tab" data-bs-toggle="tab" data-bs-target="#category-pane" type="button" role="tab" title="Menu Categories">
            <i class="fa-solid fa-tags text-primary fs-5"></i>
            <span data-i18n="masters.categories">Categories</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Categories.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "employee" ? "active" : "")" 
                id="employee-tab" data-bs-toggle="tab" data-bs-target="#employee-pane" type="button" role="tab" title="Staff & Personnel">
            <i class="fa-solid fa-users text-danger fs-5"></i>
            <span data-i18n="masters.employees">Employees</span>
            <span class="badge bg-light text-dark border ms-1">@Model.Employees.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "inventory" ? "active" : "")" 
                id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory-pane" type="button" role="tab" title="Inventory & Raw Stock">
            <i class="fa-solid fa-boxes-stacked text-secondary fs-5"></i>
            <span data-i18n="masters.inventory">Inventory</span>
            <span class="badge bg-light text-dark border ms-1">@Model.InventoryItems.Count()</span>
        </button>

        <button class="masters-nav-tab-btn @(activeTab == "settings" ? "active" : "")" 
                id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-pane" type="button" role="tab" title="Restaurant Settings">
            <i class="fa-solid fa-gear fs-5" style="color: var(--brand-600);"></i>
            <span data-i18n="masters.restaurantSettings">Restaurant Settings</span>
            <span class="badge bg-light text-dark border ms-1" data-i18n="masters.gstAndInfo">Branding &amp; Tax</span>
        </button>
    </div>
</div>

<!-- Tab Contents -->
<div class="tab-content" id="mastersTabContent">

    <!-- ==================== TAB 1: FLOORS ==================== -->
    <div class="tab-pane fade @(activeTab == "floor" ? "show active" : "")" id="floor-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold mb-0" style="color: var(--brand-900);"><i class="fa-solid fa-building me-2" style="color: var(--brand-600);"></i><span data-i18n="masters.floors">Floors</span></h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addFloorModal">
                    <i class="fa-solid fa-plus me-1"></i> <span data-i18n="masters.addFloor">Add Floor</span>
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th data-i18n="masters.floorName">Floor Name</th>
                            <th data-i18n="menu.description">Description</th>
                            <th data-i18n="masters.displayOrder">Display Order</th>
                            <th data-i18n="masters.totalTables">Total Tables</th>
                            <th class="text-end" data-i18n="common.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var floor in Model.Floors)
                        {
                            <tr>
                                <td class="fw-bold text-muted" data-locale-digits="#@floor.Id">#@floor.Id</td>
                                <td>
                                    <span class="fw-bold fs-6 d-flex align-items-center gap-2 flex-wrap" style="color: var(--brand-900);">
                                        <i class="fa-solid fa-layer-group" style="color: var(--brand-600);"></i>
                                        <span data-i18n-dynamic data-name-en="@floor.Name" data-name-mr="@(floor.NameMr ?? "")">@floor.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(floor.NameMr))
                                        {
                                            <span class="badge floor-pill">@floor.NameMr</span>
                                        }
                                    </span>
                                </td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(floor.Description) ? "—" : floor.Description)</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1" data-locale-number="@floor.DisplayOrder">@floor.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge floor-pill rounded-pill px-3 py-1 fw-bold">
                                        <i class="fa-solid fa-chair me-1"></i><span data-locale-number="@floor.Tables.Count">@floor.Tables.Count</span> <span data-i18n="table.tablesUnit">Tables</span>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1"
                                            data-id="@floor.Id"
                                            data-name="@floor.Name"
                                            data-namemr="@(floor.NameMr ?? "")"
                                            data-desc="@floor.Description"
                                            data-order="@floor.DisplayOrder"
                                            onclick="editFloorFromBtn(this)">
                                        <i class="fa-solid fa-pen-to-square"></i> <span data-i18n="masters.edit">Edit</span>
                                    </button>
                                    <form asp-action="DeleteFloor" method="post" class="d-inline" onsubmit="return confirm('Delete floor @floor.Name? This will fail if tables exist on this floor.');">
                                        <input type="hidden" name="id" value="@floor.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete floor">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 2: TABLES ==================== -->
    <div class="tab-pane fade @(activeTab == "table" ? "show active" : "")" id="table-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold mb-0" style="color: var(--brand-900);"><i class="fa-solid fa-chair me-2" style="color: var(--brand-600);"></i><span data-i18n="masters.tables">Tables</span></h4>
                <div class="d-flex gap-2">
                    <a href="/Tables" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-eye me-1"></i> <span data-i18n="masters.liveFloorPlan">Live Floor Plan</span>
                    </a>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTableModal">
                        <i class="fa-solid fa-plus me-1"></i> <span data-i18n="masters.addTable">Add Table</span>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th data-i18n="masters.tableNumber">Table Number</th>
                            <th data-i18n="table.floorLabel">Floor</th>
                            <th data-i18n="masters.seatingCapacity">Capacity</th>
                            <th data-i18n="masters.currentStatus">Current Status</th>
                            <th data-i18n="masters.currentOrder">Current Order</th>
                            <th class="text-end" data-i18n="common.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var table in Model.Tables)
                        {
                            string statusKey = table.Status switch {
                                TableStatus.Available => "available",
                                TableStatus.Occupied => "occupied",
                                TableStatus.Reserved => "reserved",
                                TableStatus.Billing => "billing",
                                _ => "cleaning"
                            };
                            string badgeClass = "badge-" + statusKey;
                            string statusI18nKey = "table." + statusKey;
                            string cleanNum = (table.TableNumber ?? "").Replace("Table", "").Trim();

                            <tr>
                                <td class="fw-bold text-muted" data-locale-digits="#@table.Id">#@table.Id</td>
                                <td>
                                    <span class="fw-bold fs-6 d-flex align-items-center gap-2 flex-wrap" style="color: var(--brand-900);">
                                        <i class="fa-solid fa-chair" style="color: var(--brand-600);"></i>
                                        <span data-i18n-table data-table-num="@cleanNum" data-name-mr="@(table.NameMr ?? "")">@table.TableNumber</span>
                                        @if (!string.IsNullOrWhiteSpace(table.NameMr))
                                        {
                                            <span class="badge bg-light text-secondary border">@table.NameMr</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="floor-pill" data-i18n-dynamic data-name-en="@table.FloorName" data-name-mr="@(table.FloorNameMr ?? "")">
                                        @table.FloorName
                                    </span>
                                </td>
                                <td>
                                    <span class="seat-pill">
                                        <i class="fa-solid fa-users text-muted me-1"></i><span data-locale-number="@table.Capacity">@table.Capacity</span> <span data-i18n="table.guests">Guests</span>
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge @badgeClass" data-i18n="@statusI18nKey">@table.StatusName</span>
                                </td>
                                <td>
                                    @if (table.CurrentOrderId.HasValue)
                                    {
                                        <span class="fw-bold" style="color: var(--leaf);" data-locale-currency="@table.CurrentOrderAmount">₹@table.CurrentOrderAmount.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1"
                                            data-id="@table.Id"
                                            data-number="@table.TableNumber"
                                            data-namemr="@(table.NameMr ?? "")"
                                            data-floorid="@table.FloorId"
                                            data-capacity="@table.Capacity"
                                            onclick="editTableFromBtn(this)">
                                        <i class="fa-solid fa-pen-to-square"></i> <span data-i18n="masters.edit">Edit</span>
                                    </button>
                                    <form asp-action="DeleteTable" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @table.TableNumber?');">
                                        <input type="hidden" name="id" value="@table.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete table">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 3: MENU ITEMS ==================== -->
    <div class="tab-pane fade @(activeTab == "menu" ? "show active" : "")" id="menu-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-bowl-food text-success me-2"></i>Menu Items</h4>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Add a new category">
                        <i class="fa-solid fa-folder-plus me-1"></i> Add Category
                    </button>
                    <button class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addMenuItemModal" title="Add a new food dish or beverage">
                        <i class="fa-solid fa-plus me-1"></i> Add Menu Item
                    </button>
                </div>
            </div>

            <!-- Categories Quick Filter Pills -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom align-items-center">
                <span class="fw-bold text-secondary small me-2"><i class="fa-solid fa-tags me-1"></i><span data-i18n="masters.categories">Categories</span>:</span>
                @foreach (var cat in Model.Categories)
                {
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill d-flex align-items-center gap-2">
                        <strong data-i18n-dynamic data-name-en="@cat.Name" data-name-mr="@(cat.NameMr ?? "")">@cat.Name</strong>
                        <span class="badge bg-secondary rounded-pill">@cat.ItemCount</span>
                        <button type="button" class="btn btn-link text-primary p-0 border-0"
                                data-id="@cat.Id" data-name="@cat.Name" data-namemr="@(cat.NameMr ?? "")" data-desc="@cat.Description" data-order="@cat.DisplayOrder"
                                onclick="editCategoryFromBtn(this)" title="Edit Category">
                            <i class="fa-solid fa-pen-to-square small"></i>
                        </button>
                    </span>
                }
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th data-i18n="menu.itemName">Dish / Item Name</th>
                            <th data-i18n="menu.category">Category</th>
                            <th data-i18n="menu.type">Type</th>
                            <th data-i18n="menu.price">Price</th>
                            <th data-i18n="menu.prepTime">Prep Time</th>
                            <th data-i18n="menu.status">Status</th>
                            <th class="text-end" data-i18n="menu.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.MenuItems)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.Id</td>
                                <td>
                                    <div>
                                        <span class="fw-bold text-dark fs-6" data-i18n-dynamic data-name-en="@item.Name" data-name-mr="@(item.NameMr ?? "")">@item.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(item.NameMr))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@item.NameMr</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1"
                                          data-i18n-dynamic data-name-en="@item.CategoryName" data-name-mr="@(item.CategoryNameMr ?? "")">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsVeg)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-leaf me-1"></i><span data-i18n="menu.veg">Veg</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-drumstick-bite me-1"></i><span data-i18n="menu.nonVeg">Non-Veg</span>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">₹@item.Price.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="small text-secondary">
                                        <i class="fa-regular fa-clock me-1"></i>@item.PreparationTimeMinutes mins
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="ToggleMenuItemAvailability" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        @if (item.IsAvailable)
                                        {
                                            <button type="submit" class="badge bg-success border-0 px-3 py-2 rounded-pill text-white cursor-pointer" data-bs-toggle="tooltip" title="Click to mark Out of Stock">
                                                <i class="fa-solid fa-check me-1"></i> <span data-i18n="menu.available">Available</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="badge bg-danger border-0 px-3 py-2 rounded-pill text-white cursor-pointer" data-bs-toggle="tooltip" title="Click to mark Available">
                                                <i class="fa-solid fa-ban me-1"></i> <span data-i18n="menu.outOfStock">Out of Stock</span>
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            data-id="@item.Id" data-cat="@item.CategoryId" data-name="@item.Name" data-namemr="@(item.NameMr ?? "")" data-desc="@item.Description" data-price="@item.Price" data-tax="@item.TaxPercentage" data-veg="@(item.IsVeg ? "true" : "false")" data-prep="@item.PreparationTimeMinutes"
                                            onclick="editMenuItemFromBtn(this)" 
                                            data-bs-toggle="tooltip" title="Edit menu item">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteMenuItem" method="post" class="d-inline" onsubmit="return confirm('Delete @item.Name from menu?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete menu item">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 4: CATEGORIES ==================== -->
    <div class="tab-pane fade @(activeTab == "category" ? "show active" : "")" id="category-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tags text-primary me-2"></i>Categories</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Add a new category">
                    <i class="fa-solid fa-plus me-1"></i> Add Category
                </button>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Total Menu Items</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@cat.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-tag text-primary"></i>
                                        <span data-i18n-dynamic data-name-en="@cat.Name" data-name-mr="@(cat.NameMr ?? "")">@cat.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(cat.NameMr))
                                        {
                                            <span class="badge bg-light text-secondary border">@cat.NameMr</span>
                                        }
                                    </span>
                                </td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">Order @cat.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                                        @cat.ItemCount Items
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            data-id="@cat.Id" data-name="@cat.Name" data-namemr="@(cat.NameMr ?? "")" data-desc="@cat.Description" data-order="@cat.DisplayOrder"
                                            onclick="editCategoryFromBtn(this)" 
                                            data-bs-toggle="tooltip" title="Edit category">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete category @cat.Name?');">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete category">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 5: EMPLOYEES ==================== -->
    <div class="tab-pane fade @(activeTab == "employee" ? "show active" : "")" id="employee-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-users text-danger me-2"></i>Employees</h4>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addEmployeeModal" title="Register a new employee">
                    <i class="fa-solid fa-user-plus me-1"></i> Add Employee
                </button>
            </div>

            <!-- Role Summary Badges -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom">
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2 rounded-pill">
                    All Staff: <strong>@Model.Employees.Count()</strong>
                </span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-briefcase me-1"></i>Managers: <strong>@Model.Employees.Count(e => e.Role == UserRole.Manager)</strong>
                </span>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-kitchen-set me-1"></i>Cooks / Kitchen: <strong>@Model.Employees.Count(e => e.Role == UserRole.Cook || e.Role == UserRole.KitchenStaff)</strong>
                </span>
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-tray me-1"></i>Waiters: <strong>@Model.Employees.Count(e => e.Role == UserRole.Waiter)</strong>
                </span>
                <span class="badge bg-teal-subtle text-teal border px-3 py-2 rounded-pill" style="background:#ccfbf1; color:#0f766e; border-color:#99f6e4;">
                    <i class="fa-solid fa-broom me-1"></i>Housekeeping: <strong>@Model.Employees.Count(e => e.Role == UserRole.Housekeeping)</strong>
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-cash-register me-1"></i>Cashiers: <strong>@Model.Employees.Count(e => e.Role == UserRole.Cashier)</strong>
                </span>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Employee Name</th>
                            <th>Role / Designation</th>
                            <th>Contact Phone</th>
                            <th>Email</th>
                            <th>Work Shift</th>
                            <th>Base Salary</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            string roleBadgeClass = emp.Role switch {
                                UserRole.Admin => "bg-danger text-white",
                                UserRole.Manager => "bg-dark text-white",
                                UserRole.Cashier => "bg-success text-white",
                                UserRole.Waiter => "bg-info text-white",
                                UserRole.Cook => "bg-warning text-dark",
                                UserRole.KitchenStaff => "bg-warning text-dark",
                                UserRole.Housekeeping => "text-white",
                                _ => "bg-secondary text-white"
                            };

                            string roleIcon = emp.Role switch {
                                UserRole.Admin => "fa-user-gear",
                                UserRole.Manager => "fa-briefcase",
                                UserRole.Cashier => "fa-cash-register",
                                UserRole.Waiter => "fa-tray",
                                UserRole.Cook => "fa-kitchen-set",
                                UserRole.KitchenStaff => "fa-fire-burner",
                                UserRole.Housekeeping => "fa-broom",
                                _ => "fa-user"
                            };

                            <tr>
                                <td class="fw-bold text-muted">#@emp.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-primary fw-bold" style="width:36px; height:36px;">
                                            @emp.Name.FirstOrDefault()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6">@emp.Name</div>
                                            <div class="small text-muted">Joined: @emp.JoiningDate.ToString("MMM yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @roleBadgeClass px-3 py-1 rounded-pill" style="@(emp.Role == UserRole.Housekeeping ? "background-color: #0d9488;" : "")">
                                        <i class="fa-solid @roleIcon me-1"></i>@emp.RoleName
                                    </span>
                                </td>
                                <td>
                                    <span class="text-dark fw-semibold">
                                        <i class="fa-solid fa-phone text-muted me-1 small"></i>@emp.Phone
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(emp.Email) ? "—" : emp.Email)</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="fa-regular fa-sun text-warning me-1"></i>@emp.Shift
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">₹@emp.BaseSalary.ToString("N0")</span>
                                </td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" 
                                            onclick="editEmployee(@emp.Id, '@emp.Name', '@emp.Email', '@emp.Phone', @((int)emp.Role), '@emp.Shift', @emp.BaseSalary, @(emp.IsActive ? "true" : "false"))" 
                                            data-bs-toggle="tooltip" title="Edit employee profile">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form asp-action="DeleteEmployee" method="post" class="d-inline" onsubmit="return confirm('Remove employee @emp.Name?');">
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" data-bs-toggle="tooltip" title="Delete employee">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 6: INVENTORY ==================== -->
    <div class="tab-pane fade @(activeTab == "inventory" ? "show active" : "")" id="inventory-pane" role="tabpanel">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-boxes-stacked text-secondary me-2"></i>Inventory</h4>
                <a href="/Inventory" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Open full inventory system">
                    <i class="fa-solid fa-boxes-stacked me-1"></i> Open Stock System
                </a>
            </div>

            <div class="table-responsive">
                <table class="table app-datagrid align-middle">
                    <thead>
                        <tr>
                            <th>Ingredient Item</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Minimum Level</th>
                            <th>Unit Cost</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1 rounded-pill">@item.Category</span></td>
                                <td class="fw-bold fs-6 @(item.IsLowStock ? "text-danger" : "text-success")">
                                    @item.CurrentStock @item.Unit
                                </td>
                                <td class="small text-secondary">@item.MinimumStock @item.Unit</td>
                                <td class="text-dark">₹@item.UnitCost.ToString("N0") / @item.Unit</td>
                                <td>
                                    @if (item.CurrentStock <= (item.MinimumStock / 2m))
                                    {
                                        <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-exclamation me-1"></i> Critical Low</span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Optimal</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="adjustStock(@item.Id, '@item.Name', '@item.Unit')">
                                        <i class="fa-solid fa-sliders me-1"></i> Adjust Stock
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 7: RESTAURANT SETTINGS ==================== -->
    <div class="tab-pane fade @(activeTab == "settings" ? "show active" : "")" id="settings-pane" role="tabpanel">
        @{
            var setting = Model.Setting ?? new RestaurantSetting();
            var cfgName = string.IsNullOrWhiteSpace(setting.RestaurantName) ? "Hotel Kumbharwada" : setting.RestaurantName;
            var cfgInitial = cfgName.Trim().Length > 0 ? cfgName.Trim()[0].ToString().ToUpperInvariant() : "H";
            var hasLogo = !string.IsNullOrWhiteSpace(setting.LogoUrl);
        }
        <div class="glass-card p-4 mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--brand-900);">
                        <i class="fa-solid fa-sliders me-2" style="color: var(--brand-600);"></i><span data-i18n="settings.heading">Restaurant Settings</span>
                    </h4>
                    <p class="small text-secondary mb-0" data-i18n="settings.subheading">Configure hotel identity (English &amp; Marathi), logo, address, phone and billing taxes.</p>
                </div>
            </div>

            <form id="restaurantConfigForm" enctype="multipart/form-data" novalidate>
                <input type="hidden" id="cfgRemoveLogo" name="RemoveLogo" value="false" />

                <h5 class="fw-bold mb-3" style="color: var(--brand-900);">
                    <i class="fa-solid fa-store me-2" style="color: var(--brand-600);"></i><span data-i18n="settings.identitySection">Hotel Identity &amp; Contact</span>
                </h5>

                <div class="row g-3 mb-4 align-items-start">
                    <!-- Logo Upload + Live Preview + Remove + First-Letter Circle Fallback -->
                    <div class="col-12">
                        <label class="form-label fw-bold small d-block" data-i18n="settings.logoLabel">Hotel Logo</label>
                        <div class="d-flex flex-wrap align-items-center gap-3 p-3 rounded-3 border" style="background: var(--surface-page); border-color: var(--border-color) !important;">
                            <div class="logo-preview-box" id="logoPreviewBox">
                                <img id="logoPreviewImg" src="@(hasLogo ? setting.LogoUrl : "")" alt="@cfgName" class="@(hasLogo ? "" : "d-none")" />
                                <span id="logoPreviewFallback" class="@(hasLogo ? "d-none" : "")">@cfgInitial</span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap gap-2 mb-1">
                                    <label class="btn btn-outline-primary rounded-pill px-3 mb-0" for="cfgLogoFile" style="cursor: pointer;">
                                        <i class="fa-solid fa-upload me-1"></i>
                                        <span data-i18n="settings.uploadLogo">Upload Logo</span>
                                    </label>
                                    <input type="file" id="cfgLogoFile" name="logoFile" accept=".png,.jpg,.jpeg,.svg,.webp,image/png,image/jpeg,image/svg+xml,image/webp" class="d-none" />
                                    <button type="button" id="removeLogoBtn" class="btn btn-outline-danger rounded-pill px-3 @(hasLogo ? "" : "d-none")">
                                        <i class="fa-solid fa-trash-can me-1"></i>
                                        <span data-i18n="settings.removeLogo">Remove</span>
                                    </button>
                                </div>
                                <div class="small text-secondary" data-i18n="settings.logoHint">
                                    PNG, JPG, SVG or WebP (max 1 MB). Falls back to initial circle if removed.
                                </div>
                                <div id="logoValidationMsg" class="small text-danger fw-semibold mt-1 d-none"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgRestaurantName">
                            <span data-i18n="settings.restaurantNameEn">Hotel Name (English)</span> <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="cfgRestaurantName" name="RestaurantName" class="form-control" value="@setting.RestaurantName"
                               placeholder="Enter hotel name in English" data-i18n-placeholder="settings.restaurantNamePlaceholder" required maxlength="120" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgRestaurantNameMr" data-i18n="settings.restaurantNameMr">Hotel Name (मराठी)</label>
                        <input type="text" id="cfgRestaurantNameMr" name="RestaurantNameMr" class="form-control" value="@setting.RestaurantNameMr"
                               placeholder="हॉटेलचे नाव मराठीत प्रविष्ट करा" data-i18n-placeholder="settings.restaurantNameMrPlaceholder" maxlength="120" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgTagline" data-i18n="settings.taglineEn">Tagline (English, optional)</label>
                        <input type="text" id="cfgTagline" name="Tagline" class="form-control" value="@setting.Tagline"
                               placeholder="e.g. Authentic Village Dining & Hospitality" data-i18n-placeholder="settings.taglinePlaceholder" maxlength="160" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgTaglineMr" data-i18n="settings.taglineMr">Tagline (मराठी, optional)</label>
                        <input type="text" id="cfgTaglineMr" name="TaglineMr" class="form-control" value="@setting.TaglineMr"
                               placeholder="उदा. अस्सल गावरान जेवण आणि आतिथ्य" data-i18n-placeholder="settings.taglineMrPlaceholder" maxlength="160" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgPhone" data-i18n="settings.phone">Phone Number (optional)</label>
                        <input type="tel" id="cfgPhone" name="Phone" class="form-control" value="@setting.Phone"
                               placeholder="e.g. +91 98765 43210" data-i18n-placeholder="settings.phonePlaceholder" maxlength="30" />
                    </div>
                </div>

                <h5 class="fw-bold mb-3 border-top pt-3" style="color: var(--brand-900);">
                    <i class="fa-solid fa-location-dot me-2" style="color: var(--brand-600);"></i><span data-i18n="settings.addressSection">Address Details</span>
                </h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgAddressLine1" data-i18n="settings.addressLine1">Address Line 1 (English)</label>
                        <input type="text" id="cfgAddressLine1" name="AddressLine1" class="form-control" value="@setting.AddressLine1"
                               placeholder="Building, street, landmark" data-i18n-placeholder="settings.addressLine1Placeholder" maxlength="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" for="cfgAddressLine2" data-i18n="settings.addressLine2">Address Line 2 (English, optional)</label>
                        <input type="text" id="cfgAddressLine2" name="AddressLine2" class="form-control" value="@setting.AddressLine2"
                               placeholder="Area, sector (optional)" data-i18n-placeholder="settings.addressLine2Placeholder" maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small" for="cfgCity" data-i18n="settings.city">City</label>
                        <input type="text" id="cfgCity" name="City" class="form-control" value="@setting.City"
                               placeholder="City" data-i18n-placeholder="settings.cityPlaceholder" maxlength="100" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small" for="cfgState" data-i18n="settings.state">State</label>
                        <input type="text" id="cfgState" name="State" class="form-control" value="@setting.State"
                               placeholder="State" data-i18n-placeholder="settings.statePlaceholder" maxlength="100" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small" for="cfgPinCode" data-i18n="settings.pinCode">PIN Code</label>
                        <input type="text" id="cfgPinCode" name="PinCode" class="form-control" value="@setting.PinCode"
                               placeholder="6-digit PIN code" data-i18n-placeholder="settings.pinCodePlaceholder" maxlength="12" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small" for="cfgAddressMr" data-i18n="settings.addressMr">Address (मराठी)</label>
                        <input type="text" id="cfgAddressMr" name="AddressMr" class="form-control" value="@setting.AddressMr"
                               placeholder="संपूर्ण पत्ता मराठीत प्रविष्ट करा" data-i18n-placeholder="settings.addressMrPlaceholder" maxlength="300" />
                    </div>
                </div>

                <div class="border-top pt-3 d-flex justify-content-end mb-2">
                    <button type="submit" id="saveRestaurantConfigBtn" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                        <span class="spinner-border spinner-border-sm d-none" id="saveConfigSpinner" role="status" aria-hidden="true"></span>
                        <i class="fa-solid fa-floppy-disk me-1" id="saveConfigIcon"></i>
                        <span id="saveConfigBtnText" data-i18n="settings.saveRestaurantConfig">Save Restaurant Settings</span>
                    </button>
                </div>
            </form>
        </div>

        <div class="glass-card p-4">
            <form asp-action="UpdateSettings" method="post" class="needs-validation">
                <input type="hidden" name="Id" value="@setting.Id" />
                <input type="hidden" name="RestaurantName" id="taxFormRestaurantName" value="@setting.RestaurantName" />
                <input type="hidden" name="RestaurantNameMr" id="taxFormRestaurantNameMr" value="@setting.RestaurantNameMr" />
                <input type="hidden" name="Tagline" value="@setting.Tagline" />
                <input type="hidden" name="TaglineMr" id="taxFormTaglineMr" value="@setting.TaglineMr" />
                <input type="hidden" name="AddressLine1" value="@setting.AddressLine1" />
                <input type="hidden" name="AddressLine2" value="@setting.AddressLine2" />
                <input type="hidden" name="City" value="@setting.City" />
                <input type="hidden" name="State" value="@setting.State" />
                <input type="hidden" name="PinCode" value="@setting.PinCode" />
                <input type="hidden" name="AddressMr" id="taxFormAddressMr" value="@setting.AddressMr" />
                <input type="hidden" name="Phone" value="@setting.Phone" />
                <input type="hidden" name="Address" value="@setting.Address" />

                <h5 class="fw-bold mb-3" style="color: var(--brand-900);">
                    <i class="fa-solid fa-percent me-2" style="color: var(--brand-600);"></i><span data-i18n="settings.taxAndPoliciesSection">Tax, Surcharge &amp; Billing Policies</span>
                </h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" data-i18n="settings.gstin">GSTIN (Tax Identification Number)</label>
                        <input type="text" name="GSTIN" class="form-control" value="@setting.GSTIN" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" data-i18n="settings.officialEmail">Official Email</label>
                        <input type="email" name="Email" class="form-control" value="@setting.Email" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small" data-i18n="settings.currencySymbol">Currency Symbol</label>
                        <input type="text" name="CurrencySymbol" class="form-control" value="@setting.CurrencySymbol" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small" data-i18n="settings.cgst">CGST (%)</label>
                        <input type="number" step="0.1" name="CGSTPercentage" class="form-control" value="@setting.CGSTPercentage" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small" data-i18n="settings.sgst">SGST (%)</label>
                        <input type="number" step="0.1" name="SGSTPercentage" class="form-control" value="@setting.SGSTPercentage" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small" data-i18n="settings.serviceCharge">Service Charge (%)</label>
                        <input type="number" step="0.1" name="ServiceChargePercentage" class="form-control" value="@setting.ServiceChargePercentage" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" data-i18n="settings.packagingCharge">Takeaway Packaging Charge (₹)</label>
                        <input type="number" step="1" name="PackagingCharge" class="form-control" value="@setting.PackagingCharge" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small" data-i18n="settings.deliveryCharge">Delivery Charge (₹)</label>
                        <input type="number" step="1" name="DeliveryCharge" class="form-control" value="@setting.DeliveryCharge" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small" data-i18n="settings.autoMarkServed">Auto-mark Served (Minutes after KOT)</label>
                        <select name="AutoMarkServedMinutes" class="form-select">
                            <option value="0" selected="@(setting.AutoMarkServedMinutes == 0)">Off (Manual tap)</option>
                            <option value="15" selected="@(setting.AutoMarkServedMinutes == 15)">15 Minutes</option>
                            <option value="30" selected="@(setting.AutoMarkServedMinutes == 30)">30 Minutes</option>
                            <option value="45" selected="@(setting.AutoMarkServedMinutes == 45)">45 Minutes</option>
                            <option value="60" selected="@(setting.AutoMarkServedMinutes == 60)">60 Minutes</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small" data-i18n="settings.voidPolicy">Void / Cancel Approval Policy</label>
                        <select name="VoidApproval" class="form-select">
                            <option value="1" selected="@(setting.VoidApproval == VoidApprovalSetting.ManagerPIN)">Manager PIN Required</option>
                            <option value="2" selected="@(setting.VoidApproval == VoidApprovalSetting.AnySignedInUser)">Any signed-in user with reason</option>
                            <option value="3" selected="@(setting.VoidApproval == VoidApprovalSetting.Off)">Off (No approval check)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
