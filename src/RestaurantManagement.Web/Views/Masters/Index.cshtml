                            <option value="7">Cook / Chef</option>
                            <option value="4">Waiter</option>
                            <option value="8">Housekeeping / Cleaner</option>
                            <option value="3">Cashier</option>
                            <option value="5">Kitchen Staff</option>
                            <option value="6">Inventory Staff</option>
                            <option value="1">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Phone</label>
                        <input type="tel" name="Phone" id="editEmpPhone" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Email</label>
                        <input type="email" name="Email" id="editEmpEmail" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Shift</label>
                        <select name="Shift" id="editEmpShift" class="form-select">
                            <option value="Morning">Morning Shift</option>
                            <option value="Evening">Evening Shift</option>
                            <option value="General">General Shift</option>
                            <option value="Night">Night Shift</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Salary (₹)</label>
                        <input type="number" name="BaseSalary" id="editEmpSalary" class="form-control" min="0" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Status</label>
                        <select name="IsActive" id="editEmpIsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Update Employee</button>
            </div>
        </form>
    </div>
</div>

<!-- 11. Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AdjustStock" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            <input type="hidden" name="InventoryItemId" id="adjustItemId" />
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-sliders text-primary me-2"></i>Adjust Stock: <span id="adjustItemName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Action Type</label>
                    <select name="TransactionType" class="form-select">
                        <option value="IN">Stock In (Purchase Receive)</option>
                        <option value="OUT">Stock Out (Manual Deduction)</option>
                        <option value="WASTAGE">Wastage / Spoiled</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Quantity (<span id="adjustItemUnit"></span>)</label>
                    <input type="number" step="0.01" name="Quantity" class="form-control" placeholder="e.g. 10" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Notes / Reason</label>
                    <input type="text" name="Notes" class="form-control" placeholder="Stock update notes..." />
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Record Adjustment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function editFloorFromBtn(btn) {
        $('#editFloorId').val(btn.dataset.id);
        $('#editFloorName').val(btn.dataset.name || '');
        $('#editFloorNameMr').val(btn.dataset.namemr || '');
        $('#editFloorDescription').val(btn.dataset.desc || '');
        $('#editFloorOrder').val(btn.dataset.order || 1);
        new bootstrap.Modal('#editFloorModal').show();
    }

    function editTableFromBtn(btn) {
        $('#editTableId').val(btn.dataset.id);
        $('#editTableNumber').val(btn.dataset.number || '');
        $('#editTableNameMr').val(btn.dataset.namemr || '');
        $('#editTableFloorId').val(btn.dataset.floorid);
        $('#editTableCapacity').val(btn.dataset.capacity || 4);
        new bootstrap.Modal('#editTableModal').show();
    }

    function editCategoryFromBtn(btn) {
        $('#editCategoryId').val(btn.dataset.id);
        $('#editCategoryName').val(btn.dataset.name || '');
        $('#editCategoryNameMr').val(btn.dataset.namemr || '');
        $('#editCategoryDescription').val(btn.dataset.desc || '');
        $('#editCategoryOrder').val(btn.dataset.order || 1);
        new bootstrap.Modal('#editCategoryModal').show();
    }

    function editMenuItemFromBtn(btn) {
        $('#editMenuItemId').val(btn.dataset.id);
        $('#editMenuItemCatId').val(btn.dataset.cat);
        $('#editMenuItemName').val(btn.dataset.name || '');
        $('#editMenuItemNameMr').val(btn.dataset.namemr || '');
        $('#editMenuItemDesc').val(btn.dataset.desc || '');
        $('#editMenuItemPrice').val(btn.dataset.price || '');
        $('#editMenuItemTax').val(btn.dataset.tax || '');
        $('#editMenuItemIsVeg').val(btn.dataset.veg === 'true' ? "true" : "false");
        $('#editMenuItemPrepTime').val(btn.dataset.prep || 15);
        new bootstrap.Modal('#editMenuItemModal').show();
    }

    function editEmployee(id, name, email, phone, role, shift, salary, isActive) {
        $('#editEmpId').val(id);
        $('#editEmpName').val(name);
        $('#editEmpEmail').val(email);
        $('#editEmpPhone').val(phone);
        $('#editEmpRole').val(role);
        $('#editEmpShift').val(shift);
        $('#editEmpSalary').val(salary);
        $('#editEmpIsActive').val(isActive ? "true" : "false");
        new bootstrap.Modal('#editEmployeeModal').show();
    }

    function adjustStock(id, name, unit) {
        $('#adjustItemId').val(id);
        $('#adjustItemName').text(name);
        $('#adjustItemUnit').text(unit);
        new bootstrap.Modal('#adjustStockModal').show();
    }

    $(document).ready(function() {
        @if (Model.OpenAdd)
        {
            <text>
            setTimeout(function() {
                var addModal = new bootstrap.Modal(document.getElementById('addMenuItemModal'));
                addModal.show();
            }, 300);
            </text>
        }

        // Restaurant Configuration Live Preview, Validation & Toast Save
        const cfgNameInput = document.getElementById('cfgRestaurantName');
        const cfgLogoInput = document.getElementById('cfgLogoFile');
        const removeLogoBtn = document.getElementById('removeLogoBtn');
        const removeLogoField = document.getElementById('cfgRemoveLogo');
        const logoPreviewImg = document.getElementById('logoPreviewImg');
        const logoPreviewFallback = document.getElementById('logoPreviewFallback');
        const logoValidationMsg = document.getElementById('logoValidationMsg');
        const configForm = document.getElementById('restaurantConfigForm');
        const MAX_LOGO_BYTES = 1024 * 1024;
        const ALLOWED_EXT = /\.(png|jpe?g|svg|webp)$/i;

        function updateInitialFallback() {
            const val = (cfgNameInput?.value || '').trim();
            if (logoPreviewFallback) {
                logoPreviewFallback.textContent = val ? val.charAt(0).toUpperCase() : 'H';
            }
            const taxNameInput = document.getElementById('taxFormRestaurantName');
            if (taxNameInput && val) {
                taxNameInput.value = val;
            }
            const taxNameMrInput = document.getElementById('taxFormRestaurantNameMr');
            const nameMrInput = document.getElementById('cfgRestaurantNameMr');
            if (taxNameMrInput && nameMrInput) {
                taxNameMrInput.value = nameMrInput.value.trim();
            }
            const taxTaglineMrInput = document.getElementById('taxFormTaglineMr');
            const taglineMrInput = document.getElementById('cfgTaglineMr');
            if (taxTaglineMrInput && taglineMrInput) {
                taxTaglineMrInput.value = taglineMrInput.value.trim();
            }
            const taxAddressMrInput = document.getElementById('taxFormAddressMr');
            const addressMrInput = document.getElementById('cfgAddressMr');
            if (taxAddressMrInput && addressMrInput) {
                taxAddressMrInput.value = addressMrInput.value.trim();
            }
        }

        if (cfgNameInput) {
            cfgNameInput.addEventListener('input', updateInitialFallback);
        }

        if (cfgLogoInput) {
            cfgLogoInput.addEventListener('change', function () {
                logoValidationMsg.classList.add('d-none');
                const file = this.files && this.files[0];
                if (!file) return;

                if (!ALLOWED_EXT.test(file.name)) {
                    const msg = I18n.t('validation.logoInvalidType');
                    logoValidationMsg.textContent = msg;
                    logoValidationMsg.classList.remove('d-none');
                    RmsUI.showToast(msg, 'error');
                    this.value = '';
                    return;
                }
                if (file.size > MAX_LOGO_BYTES) {
                    const msg = I18n.t('validation.logoTooLarge');
                    logoValidationMsg.textContent = msg;
                    logoValidationMsg.classList.remove('d-none');
                    RmsUI.showToast(msg, 'error');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (ev) {
                    logoPreviewImg.src = ev.target.result;
                    logoPreviewImg.classList.remove('d-none');
                    logoPreviewFallback.classList.add('d-none');
                    removeLogoBtn.classList.remove('d-none');
                    removeLogoField.value = 'false';
                };
                reader.readAsDataURL(file);
            });
        }

        if (removeLogoBtn) {
            removeLogoBtn.addEventListener('click', function () {
                if (cfgLogoInput) cfgLogoInput.value = '';
                removeLogoField.value = 'true';
                logoPreviewImg.removeAttribute('src');
                logoPreviewImg.classList.add('d-none');
                logoPreviewFallback.classList.remove('d-none');
                removeLogoBtn.classList.add('d-none');
                updateInitialFallback();
                RmsUI.showToast(I18n.t('toast.logoRemoved'), 'success');
            });
        }

        if (configForm) {
            configForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const nameVal = (cfgNameInput?.value || '').trim();
                if (!nameVal) {
                    cfgNameInput.focus();
                    RmsUI.showToast(I18n.t('validation.restaurantNameRequired'), 'error');
                    return;
                }

                const pinVal = (document.getElementById('cfgPinCode')?.value || '').trim();
                if (pinVal && !/^[A-Za-z0-9\-\s]{4,10}$/.test(pinVal)) {
                    document.getElementById('cfgPinCode').focus();
                    RmsUI.showToast(I18n.t('validation.pinInvalid'), 'error');
                    return;
                }

                const saveBtn = document.getElementById('saveRestaurantConfigBtn');
                const spinner = document.getElementById('saveConfigSpinner');
                const icon = document.getElementById('saveConfigIcon');
                const textEl = document.getElementById('saveConfigBtnText');

                saveBtn.disabled = true;
                spinner.classList.remove('d-none');
                icon.classList.add('d-none');
                textEl.textContent = I18n.t('settings.saving');

                try {
                    const formData = new FormData(configForm);
                    const resp = await fetch('/Masters/UpdateRestaurantConfig', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await resp.json();

                    if (resp.ok && data.success) {
                        RmsUI.applyRestaurantBranding(data.settings);
                        RmsUI.showToast(I18n.t(data.messageKey || 'toast.settingsSaved'), 'success');
                    } else {
                        RmsUI.showToast(I18n.t(data.messageKey || 'toast.settingsError'), 'error');
                    }
                } catch (err) {
                    RmsUI.showToast(I18n.t('toast.settingsError'), 'error');
                } finally {
                    saveBtn.disabled = false;
                    spinner.classList.add('d-none');
                    icon.classList.remove('d-none');
                    textEl.textContent = I18n.t('settings.saveRestaurantConfig');
                }
            });
        }
    });
</script>
}
