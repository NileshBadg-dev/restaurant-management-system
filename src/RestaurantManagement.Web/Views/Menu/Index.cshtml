@model IEnumerable<MenuItemDto>
@{
    ViewData["Title"] = "Menu Management";
    ViewData["TitleKey"] = "nav.menuItems";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto> ?? new List<CategoryDto>();
    string? returnUrl = Context.Request.Query["returnUrl"];
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold" style="color: var(--brand-600);">
                        <i class="fa-solid fa-chart-pie me-1"></i> <span data-i18n="nav.dashboard">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-bowl-food me-1" style="color: var(--brand-600);"></i> <span data-i18n="menu.title">Food &amp; Beverage Menu</span>
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0" style="color: var(--brand-900);">
            <i class="fa-solid fa-bowl-food me-2" style="color: var(--brand-600);"></i><span data-i18n="menu.title">Food &amp; Beverage Menu</span>
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> <span data-i18n="header.backToDashboard">Back to Dashboard</span>
        </a>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addItemModal">
            <i class="fa-solid fa-plus me-1"></i> <span data-i18n="menu.addItem">Add Menu Item</span>
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th data-i18n="menu.type">Type</th>
                    <th data-i18n="menu.itemName">Item Name</th>
                    <th data-i18n="menu.category">Category</th>
                    <th data-i18n="menu.price">Price</th>
                    <th data-i18n="menu.prepTime">Prep Time</th>
                    <th data-i18n="menu.status">Status</th>
                    <th class="text-end" data-i18n="menu.actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.IsVeg)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                    <i class="fa-solid fa-leaf me-1"></i><span data-i18n="menu.veg">Veg</span>
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                    <i class="fa-solid fa-drumstick-bite me-1"></i><span data-i18n="menu.nonVeg">Non-Veg</span>
                                </span>
                            }
                        </td>
                        <td>
                            <div class="fw-bold text-dark fs-6" data-i18n-dynamic data-name-en="@item.Name" data-name-mr="@(item.NameMr ?? "")">@item.Name</div>
                            @if (!string.IsNullOrWhiteSpace(item.NameMr))
                            {
                                <div class="small text-secondary">@item.NameMr</div>
                            }
                            <div class="small text-muted">@item.Description</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1"
                                  data-i18n-dynamic data-name-en="@item.CategoryName" data-name-mr="@(item.CategoryNameMr ?? "")">
                                @item.CategoryName
                            </span>
                        </td>
                        <td class="fw-bold text-dark fs-6" data-locale-currency="@item.Price">₹@item.Price.ToString("N0")</td>
                        <td class="small text-secondary"><i class="fa-solid fa-clock me-1"></i><span data-locale-number="@item.PreparationTimeMinutes">@item.PreparationTimeMinutes</span> <span data-i18n="menu.mins">mins</span></td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="badge status-pill-available rounded-pill px-3 py-1"><i class="fa-solid fa-circle-check me-1"></i> <span data-i18n="menu.available">Available</span></span>
                            }
                            else
                            {
                                <span class="badge status-pill-occupied rounded-pill px-3 py-1"><i class="fa-solid fa-ban me-1"></i> <span data-i18n="menu.soldOut">Sold Out</span></span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-danger" : "btn-outline-primary") rounded-pill px-3"
                                        data-i18n="@(item.IsAvailable ? "menu.markSoldOut" : "menu.markAvailable")">
                                    @(item.IsAvailable ? "Mark Sold Out" : "Mark Available")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content rounded-4 border-0 shadow-lg">
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-plus me-2 text-primary"></i><span data-i18n="menu.addItem">Add New Menu Item</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                        <i class="fa-solid fa-arrow-turn-down me-1"></i> Once added, you will return back to your previous screen.
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label fw-bold small" data-i18n="menu.category">Category</label>
                    <select name="CategoryId" class="form-select" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small" data-i18n="menu.itemName">Item Name</label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Butter Chicken" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small" data-i18n="menu.itemNameMr">Marathi Name (मराठी नाव - Optional)</label>
                    <input type="text" name="NameMr" class="form-control" placeholder="उदा. पनीर टिक्का" data-i18n-placeholder="menu.itemNameMrPlaceholder" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small" data-i18n="menu.description">Description</label>
                    <textarea name="Description" class="form-control" rows="2" placeholder="Ingredients description..."></textarea>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small" data-i18n="menu.price">Price (₹)</label>
                        <input type="number" step="0.01" name="Price" class="form-control" placeholder="299" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small" data-i18n="menu.type">Type</label>
                        <select name="IsVeg" class="form-select">
                            <option value="true" data-i18n="menu.veg">Veg</option>
                            <option value="false" data-i18n="menu.nonVeg">Non-Veg</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal" data-i18n="menu.cancel">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4" data-i18n="menu.saveItem">Save Menu Item</button>
            </div>
        </form>
    </div>
</div>
