@model IEnumerable<MenuItemDto>
@{
    ViewData["Title"] = "Menu Management";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto> ?? new List<CategoryDto>();
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-bowl-food text-warning me-2"></i>Food & Beverage Menu Master</h2>
        <p class="text-secondary mb-0">Manage items, pricing, veg/non-veg classification, and availability.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addItemModal">
            <i class="fa-solid fa-plus me-1"></i> Add Menu Item
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr class="text-secondary">
                    <th>Type</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Prep Time</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="@(item.IsVeg ? "veg-indicator" : "nonveg-indicator")" title="@(item.IsVeg ? "Veg" : "Non-Veg")"></span>
                        </td>
                        <td>
                            <div class="fw-bold text-white">@item.Name</div>
                            <div class="small text-secondary">@item.Description</div>
                        </td>
                        <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                        <td class="fw-bold text-warning">₹@item.Price.ToString("N0")</td>
                        <td class="small text-secondary"><i class="fa-solid fa-clock me-1"></i>@item.PreparationTimeMinutes Mins</td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-circle-check me-1"></i> Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-ban me-1"></i> Sold Out</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                    @(item.IsAvailable ? "Mark Sold Out" : "Mark Available")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white"><i class="fa-solid fa-plus me-2"></i>Add New Menu Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-secondary">Category</label>
                    <select name="CategoryId" class="form-select bg-dark text-white border-secondary" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary">Item Name</label>
                    <input type="text" name="Name" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Butter Chicken" required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary">Description</label>
                    <textarea name="Description" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Ingredients description..."></textarea>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label text-secondary">Price (₹)</label>
                        <input type="number" step="0.01" name="Price" class="form-control bg-dark text-white border-secondary" placeholder="299" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-secondary">Type</label>
                        <select name="IsVeg" class="form-select bg-dark text-white border-secondary">
                            <option value="true">Veg</option>
                            <option value="false">Non-Veg</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Menu Item</button>
            </div>
        </form>
    </div>
</div>
