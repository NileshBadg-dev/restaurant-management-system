@model IEnumerable<OrderDto>
@{
    ViewData["Title"] = "Orders History";
    ViewData["TitleKey"] = "orders.history";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold" style="color: var(--brand-600);">
                        <i class="fa-solid fa-chart-pie me-1"></i> <span data-i18n="nav.dashboard">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-receipt me-1" style="color: var(--brand-600);"></i> <span data-i18n="orders.history">Orders History</span>
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0" style="color: var(--brand-900);">
            <i class="fa-solid fa-receipt me-2" style="color: var(--brand-600);"></i><span data-i18n="orders.history">Orders History</span>
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> <span data-i18n="header.backToDashboard">Back to Dashboard</span>
        </a>
        <a href="/Orders/POS" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> <span data-i18n="nav.newPosOrder">New POS Order</span>
        </a>
    </div>
</div>

<div class="glass-card p-4 animated-fade-in">
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th data-i18n="orders.col.orderNo">Order #</th>
                    <th data-i18n="orders.col.type">Type</th>
                    <th data-i18n="orders.col.tableCustomer">Table / Customer</th>
                    <th data-i18n="orders.col.dateTime">Date &amp; Time</th>
                    <th data-i18n="orders.col.status">Status</th>
                    <th data-i18n="orders.col.amount">Amount</th>
                    <th class="text-end" data-i18n="common.actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0 text-muted" data-i18n="orders.noOrders">No orders found. Click "New POS Order" to create one.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        string statusBadge = order.Status switch {
                            OrderStatus.Pending => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            OrderStatus.Confirmed => "bg-info-subtle text-info-emphasis border border-info-subtle",
                            OrderStatus.Preparing => "bg-primary-subtle text-primary border border-primary-subtle",
                            OrderStatus.Ready => "status-pill-available",
                            OrderStatus.Completed => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
                            _ => "bg-danger-subtle text-danger border border-danger-subtle"
                        };
                        string statusI18n = "status." + order.Status.ToString().ToLowerInvariant();
                        string cleanNum = (order.TableNumber ?? "").Replace("Table", "").Trim();
                        string typeKey = order.OrderType == OrderType.DineIn ? "orders.type.dineIn" : (order.OrderType == OrderType.Takeaway ? "orders.type.takeaway" : "orders.type.delivery");

                        <tr>
                            <td class="fw-bold text-dark" data-locale-digits="@order.OrderNumber">@order.OrderNumber</td>
                            <td><span class="badge bg-light text-dark border rounded-pill px-3 py-1" data-i18n="@typeKey">@order.OrderTypeName</span></td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @if (!string.IsNullOrEmpty(cleanNum))
                                    {
                                        <span data-i18n-table data-table-num="@cleanNum">Table @cleanNum</span>
                                    }
                                    else
                                    {
                                        @order.CustomerName
                                    }
                                </div>
                                <div class="small text-secondary">@order.CustomerPhone</div>
                            </td>
                            <td class="small text-secondary" data-locale-datetime="@order.CreatedAt.ToString("O")">@order.CreatedAt.ToString("g")</td>
                            <td><span class="badge @statusBadge px-3 py-1 rounded-pill" data-i18n="@statusI18n">@order.StatusName</span></td>
                            <td class="fw-bold text-dark fs-6" data-locale-currency="@order.GrandTotal">₹@order.GrandTotal.ToString("N0")</td>
                            <td class="text-end">
                                <a href="/Billing/Generate?orderId=@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> <span data-i18n="orders.billAndPay">Bill &amp; Pay</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
