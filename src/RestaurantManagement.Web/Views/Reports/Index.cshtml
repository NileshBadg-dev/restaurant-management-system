@model SalesReportDto
@{
    ViewData["Title"] = "Sales & Tax Reports";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 animated-fade-in">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-6">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none fw-semibold text-success">
                        <i class="fa-solid fa-chart-pie me-1" data-bs-toggle="tooltip" title="Dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
                    <i class="fa-solid fa-chart-pie text-success me-1"></i> Reports & Analytics
                </li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-chart-pie text-success me-2"></i>Sales & Tax Reports
        </h2>
    </div>
    <div>
        <a href="/Dashboard" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" data-bs-toggle="tooltip" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4 animated-fade-in">
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center">
            <div class="text-secondary small fw-bold text-uppercase">Total Revenue</div>
            <div class="fs-2 fw-bold text-success mt-2">₹@Model.TotalRevenue.ToString("N0")</div>
            <div class="small text-secondary mt-1">Net Settled Amount</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center">
            <div class="text-secondary small fw-bold text-uppercase">Total Completed Orders</div>
            <div class="fs-2 fw-bold text-info mt-2">@Model.TotalOrders</div>
            <div class="small text-secondary mt-1">Dine-in, Takeaway & Delivery</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center">
            <div class="text-secondary small fw-bold text-uppercase">Total CGST Tax (2.5%)</div>
            <div class="fs-2 fw-bold text-warning mt-2">₹@Model.TotalCGST.ToString("N0")</div>
            <div class="small text-secondary mt-1">Central Tax Liability</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center">
            <div class="text-secondary small fw-bold text-uppercase">Total SGST Tax (2.5%)</div>
            <div class="fs-2 fw-bold text-warning mt-2">₹@Model.TotalSGST.ToString("N0")</div>
            <div class="small text-secondary mt-1">State Tax Liability</div>
        </div>
    </div>
</div>

<!-- Breakdown Table -->
<div class="glass-card p-4 animated-fade-in">
    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="fa-solid fa-calendar-days text-info me-2"></i>Daily Sales Summary</h5>
    <div class="table-responsive">
        <table class="table app-datagrid align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Total Orders</th>
                    <th>Tax Collected (GST)</th>
                    <th class="text-end">Sales Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Model.DailySummaries)
                {
                    decimal dayTax = Math.Round(day.SalesAmount * 0.05m / 1.05m, 2);
                    <tr>
                        <td class="fw-bold text-dark">@day.Date.ToString("dd MMM yyyy (ddd)")</td>
                        <td><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1">@day.OrdersCount Orders</span></td>
                        <td class="text-secondary">₹@dayTax.ToString("N0")</td>
                        <td class="text-end fw-bold text-dark fs-6">₹@day.SalesAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
