@model TableDto
@{
    ViewData["Title"] = $"Table Details - {Model.TableNumber}";
    var currentOrder = ViewBag.CurrentOrder as OrderDto;
}

<div class="row mb-4">
    <div class="col-md-8">
        <a href="/Tables" class="btn btn-outline-secondary btn-sm rounded-pill mb-2"><i class="fa-solid fa-arrow-left me-1"></i> Back to Floor Plan</a>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-chair text-warning me-2"></i>@Model.TableNumber</h2>
        <p class="text-secondary mb-0">Floor: <strong>@Model.FloorName</strong> &bull; Capacity: <strong>@Model.Capacity Guests</strong></p>
    </div>
    <div class="col-md-4 text-md-end align-self-end">
        <span class="badge bg-warning text-dark fs-5 px-3 py-2">Status: @Model.StatusName</span>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Table Details & Actions -->
    <div class="col-lg-5">
        <div class="glass-card p-4">
            <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2"><i class="fa-solid fa-sliders text-info me-2"></i>Table Actions</h5>
            
            <div class="mb-4">
                <div class="small text-secondary">Customer:</div>
                <div class="fw-bold text-white fs-5">@(currentOrder?.CustomerName ?? "Rahul Sharma (Guest)")</div>
                <div class="small text-secondary">Phone: @(currentOrder?.CustomerPhone ?? "9876543210")</div>
            </div>

            <div class="mb-4">
                <div class="small text-secondary">Current Active Order:</div>
                <div class="fs-2 fw-bold text-warning">₹@(currentOrder?.GrandTotal.ToString("N0") ?? Model.CurrentOrderAmount.ToString("N0"))</div>
                <div class="small text-secondary">Order #: @(currentOrder?.OrderNumber ?? "N/A")</div>
            </div>

            <!-- Action Buttons Grid -->
            <div class="d-grid gap-2">
                @if (Model.Status == TableStatus.Occupied || Model.Status == TableStatus.Billing)
                {
                    <a href="/Orders/POS?tableId=@Model.Id" class="btn btn-info rounded-pill fw-semibold py-2">
                        <i class="fa-solid fa-plus-circle me-1"></i> Add Items to Order
                    </a>
                    
                    @if (currentOrder != null)
                    {
                        <form asp-controller="Orders" asp-action="GenerateKOT" method="post" class="d-grid">
                            <input type="hidden" name="orderId" value="@currentOrder.Id" />
                            <button type="submit" class="btn btn-warning rounded-pill fw-semibold py-2">
                                <i class="fa-solid fa-receipt me-1"></i> Send KOT to Kitchen
                            </button>
                        </form>
                    }

                    <a href="/Billing/Generate?orderId=@(currentOrder?.Id ?? 0)" class="btn btn-success rounded-pill fw-semibold py-2">
                        <i class="fa-solid fa-file-invoice-dollar me-1"></i> Generate Bill & Settle
                    </a>
                }
                else
                {
                    <a href="/Orders/POS?tableId=@Model.Id" class="btn btn-success rounded-pill fw-semibold py-2">
                        <i class="fa-solid fa-cart-plus me-1"></i> Create New Order
                    </a>
                }

                <form asp-action="UpdateStatus" method="post" class="d-grid mt-3">
                    <input type="hidden" name="tableId" value="@Model.Id" />
                    <input type="hidden" name="status" value="@TableStatus.Available" />
                    <button type="submit" class="btn btn-outline-danger rounded-pill fw-semibold py-2">
                        <i class="fa-solid fa-circle-check me-1"></i> Mark Table Available (Release)
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Current Order Items List -->
    <div class="col-lg-7">
        <div class="glass-card p-4">
            <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2"><i class="fa-solid fa-utensils text-primary me-2"></i>Ordered Items Summary</h5>
            
            @if (currentOrder == null || !currentOrder.Items.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-bowl-rice fs-1 mb-3"></i>
                    <p>No active items ordered for this table yet.</p>
                    <a href="/Orders/POS?tableId=@Model.Id" class="btn btn-primary btn-sm rounded-pill px-4">Open POS Screen</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr class="text-secondary">
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in currentOrder.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white">@item.ItemName</div>
                                        @if (!string.IsNullOrEmpty(item.SelectedVariantName))
                                        {
                                            <span class="badge bg-secondary">@item.SelectedVariantName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                        {
                                            <div class="small text-warning"><i class="fa-solid fa-comment-dots me-1"></i>@item.SpecialInstructions</div>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.Quantity</td>
                                    <td>₹@item.UnitPrice.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">₹@item.TotalPrice.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold text-secondary">Subtotal:</td>
                                <td class="text-end fw-bold">₹@currentOrder.SubTotal.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold text-secondary">GST (5%):</td>
                                <td class="text-end fw-bold">₹@currentOrder.TotalTax.ToString("N0")</td>
                            </tr>
                            <tr class="fs-5">
                                <td colspan="3" class="text-end fw-bold text-warning">Grand Total:</td>
                                <td class="text-end fw-bold text-warning">₹@currentOrder.GrandTotal.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
