@model IEnumerable<FloorDto>
@{
    ViewData["Title"] = "Table & Floor Management";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-chair text-info me-2"></i>Table & Floor Management</h2>
        <p class="text-secondary mb-0">Click any table to view order details, add items, transfer, or generate bill.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <button class="btn btn-outline-light rounded-pill px-3 me-2" data-bs-toggle="modal" data-bs-target="#transferModal">
            <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Transfer Table
        </button>
        <button class="btn btn-outline-warning rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#mergeModal">
            <i class="fa-solid fa-code-merge me-1"></i> Merge Tables
        </button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Floor Sections -->
@foreach (var floor in Model)
{
    <div class="glass-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
            <div>
                <h4 class="fw-bold text-white mb-1"><i class="fa-solid fa-building text-warning me-2"></i>@floor.Name</h4>
                <div class="text-secondary small">@floor.Description &bull; @floor.Tables.Count Tables</div>
            </div>
            <span class="badge bg-secondary px-3 py-2 fs-6">Floor #@floor.DisplayOrder</span>
        </div>

        <div class="row g-4">
            @foreach (var table in floor.Tables)
            {
                string statusClass = table.Status switch {
                    TableStatus.Available => "status-available",
                    TableStatus.Occupied => "status-occupied",
                    TableStatus.Reserved => "status-reserved",
                    TableStatus.Billing => "status-billing",
                    _ => "status-cleaning"
                };

                string badgeClass = table.Status switch {
                    TableStatus.Available => "badge-available",
                    TableStatus.Occupied => "badge-occupied",
                    TableStatus.Reserved => "badge-reserved",
                    TableStatus.Billing => "badge-billing",
                    _ => "bg-secondary text-white"
                };

                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="table-card @statusClass h-100" onclick="window.location.href='/Tables/Details/@table.Id'">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="fw-bold text-white mb-0">@table.TableNumber</h5>
                            <span class="status-badge @badgeClass">@table.StatusName</span>
                        </div>
                        
                        <div class="small text-secondary mb-2">
                            <i class="fa-solid fa-users me-1"></i> Seats: @table.Capacity Guests
                        </div>

                        @if (table.Status == TableStatus.Occupied || table.Status == TableStatus.Billing)
                        {
                            <div class="bg-dark p-2 rounded border border-secondary mb-2">
                                <div class="d-flex justify-content-between small text-secondary">
                                    <span>Waiter:</span>
                                    <span class="text-light fw-semibold">@(table.WaiterName ?? "Amit")</span>
                                </div>
                                <div class="d-flex justify-content-between fw-bold text-warning mt-1 fs-6">
                                    <span>Current Bill:</span>
                                    <span>₹@table.CurrentOrderAmount.ToString("N0")</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/Orders/POS?tableId=@table.Id" class="btn btn-sm btn-outline-info w-50 rounded-pill">Add Items</a>
                                <a href="/Tables/Details/@table.Id" class="btn btn-sm btn-primary w-50 rounded-pill">View Order</a>
                            </div>
                        }
                        else if (table.Status == TableStatus.Available)
                        {
                            <div class="text-success small my-3"><i class="fa-solid fa-circle-check me-1"></i> Ready for Guests</div>
                            <a href="/Orders/POS?tableId=@table.Id" class="btn btn-sm btn-success w-100 rounded-pill">
                                <i class="fa-solid fa-plus me-1"></i> Create Order
                            </a>
                        }
                        else if (table.Status == TableStatus.Reserved)
                        {
                            <div class="text-info small my-3"><i class="fa-solid fa-clock me-1"></i> Reserved for 8:00 PM</div>
                            <a href="/Tables/Details/@table.Id" class="btn btn-sm btn-outline-info w-100 rounded-pill">Manage Reservation</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Transfer Table Modal -->
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Transfer" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white"><i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Transfer Table</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-secondary">Source Table (Occupied)</label>
                    <select name="sourceTableId" class="form-select bg-dark text-white border-secondary" required>
                        @foreach (var floor in Model)
                        {
                            @foreach (var t in floor.Tables.Where(x => x.Status == TableStatus.Occupied))
                            {
                                <option value="@t.Id">@t.TableNumber (@floor.Name) - Current: ₹@t.CurrentOrderAmount.ToString("N0")</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary">Target Table (Available)</label>
                    <select name="targetTableId" class="form-select bg-dark text-white border-secondary" required>
                        @foreach (var floor in Model)
                        {
                            @foreach (var t in floor.Tables.Where(x => x.Status == TableStatus.Available))
                            {
                                <option value="@t.Id">@t.TableNumber (@floor.Name) - Capacity: @t.Capacity</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Confirm Transfer</button>
            </div>
        </form>
    </div>
</div>
